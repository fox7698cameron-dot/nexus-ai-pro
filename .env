# ================================================
# NEXUS AI PRO - Environment Configuration
# Updated: 2026-07-26
# NEVER commit real secrets. Use a secrets manager in production.
# ================================================

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# AI Model API Keys — set your real keys here
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# Security — generate with: openssl rand -hex 32
ENCRYPTION_SECRET=generate_a_secure_random_string_here
ENCRYPTION_SALT=generate_another_secure_random_string_here
JWT_SECRET=generate_jwt_secret_here
JWT_REFRESH_SECRET=generate_separate_refresh_jwt_secret_here

# Payments — Stripe (never hard-code)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Crypto payments (Coinbase Commerce or similar)
CRYPTO_API_KEY=your_crypto_payment_api_key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# Cloud Connectors — OAuth credentials (never hard-code)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
GCP_PROJECT_ID=your_gcp_project_id
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ADOBE_CLIENT_ID=your_adobe_client_id

# Game Platform Connectors
EPIC_CLIENT_ID=your_epic_games_client_id
EPIC_CLIENT_SECRET=your_epic_games_client_secret
STEAM_API_KEY=your_steam_api_key
UBISOFT_CLIENT_ID=your_ubisoft_client_id

# Social Platform OAuth (for analytics)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token

# Translation
TRANSLATE_API_KEY=your_google_translate_or_deepl_api_key

# Deployment
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# Apple Developer (for iOS deployment)
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# Monitoring
GRAFANA_PASSWORD=secure_grafana_password
SLACK_WEBHOOK_URL=your_slack_webhook_url
