# ================================================
# NEXUS AI PRO - Environment Configuration
# Copy this file to .env and fill in your values
# ================================================

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# AI Model API Keys
# Get your keys from the respective providers
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# Security - Generate secure random values
# openssl rand -hex 32
ENCRYPTION_SECRET=generate_a_secure_random_string_here
ENCRYPTION_SALT=generate_another_secure_random_string_here
JWT_SECRET=generate_jwt_secret_here

# Database (for production)
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# Deployment
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# Apple Developer (for iOS deployment)
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# Monitoring
GRAFANA_PASSWORD=secure_grafana_password

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url

# Payments — Stripe
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Crypto Payments (optional)
# Wallet addresses for receiving crypto — never hardcode private keys
CRYPTO_WALLET_BTC=your_btc_wallet_address
CRYPTO_WALLET_ETH=your_eth_wallet_address
CRYPTO_WALLET_USDC=your_usdc_wallet_address

# Game Platform Connectors (optional)
EPIC_CLIENT_ID=your_epic_client_id
EPIC_CLIENT_SECRET=your_epic_client_secret
SONY_API_KEY=your_sony_api_key
MS_XBOX_CLIENT_ID=your_xbox_client_id
MS_XBOX_CLIENT_SECRET=your_xbox_client_secret
UBISOFT_API_KEY=your_ubisoft_api_key
STEAM_API_KEY=your_steam_api_key

# Social Media Analytics (optional)
TIKTOK_APP_ID=your_tiktok_app_id
TIKTOK_APP_SECRET=your_tiktok_app_secret
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Azure Connector
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret

# AWS Connector
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# GitHub / Bitbucket Connectors
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY_PATH=./github-app.pem
BITBUCKET_CLIENT_ID=your_bitbucket_client_id
BITBUCKET_CLIENT_SECRET=your_bitbucket_client_secret

# Communication Connectors
SLACK_BOT_TOKEN=your_slack_bot_token
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Adobe Creative Cloud
ADOBE_CLIENT_ID=your_adobe_client_id
ADOBE_CLIENT_SECRET=your_adobe_client_secret
