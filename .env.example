# ================================================
# NEXUS AI PRO - Environment Configuration
# Created: 2026-07-05
# Copyright © 2025-2026 Cameron Fox. All rights reserved.
#
# Copy to .env and fill in values.
# NEVER commit .env with real secrets.
# Generate secrets: openssl rand -hex 32
# ================================================

# ── Server ────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173

# ── AI Model API Keys ─────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# ── Security (generate with: openssl rand -hex 32) ─
ENCRYPTION_SECRET=replace_with_openssl_rand_hex_32
ENCRYPTION_SALT=replace_with_openssl_rand_hex_64
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32

# ── Payments ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_secret
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_stripe_publishable
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret

# ── Database & Cache ──────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ── Blob Storage ─────────────────────────────────
# Azure Blob Storage (optional)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id

# AWS S3 (optional, falls back if Azure not set)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=nexus-ai-pro-uploads

# ── Cloud Connectors ──────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

ADOBE_CLIENT_ID=your_adobe_client_id
ADOBE_CLIENT_SECRET=your_adobe_client_secret

SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_WEBHOOK_URL=your_slack_incoming_webhook_url

ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret

BITBUCKET_CLIENT_ID=your_bitbucket_client_id
BITBUCKET_CLIENT_SECRET=your_bitbucket_client_secret

# ── Game Platforms ────────────────────────────────
EPIC_CLIENT_ID=your_epic_games_client_id
EPIC_CLIENT_SECRET=your_epic_games_client_secret

SONY_CLIENT_ID=your_sony_psn_client_id
SONY_CLIENT_SECRET=your_sony_psn_client_secret

XBOX_CLIENT_ID=your_xbox_live_client_id
XBOX_CLIENT_SECRET=your_xbox_live_client_secret

UBISOFT_CLIENT_ID=your_ubisoft_client_id
UBISOFT_CLIENT_SECRET=your_ubisoft_client_secret

STEAM_API_KEY=your_steam_web_api_key

# ── Mobile / Apple ────────────────────────────────
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# ── Monitoring ────────────────────────────────────
GRAFANA_PASSWORD=replace_with_secure_grafana_password
