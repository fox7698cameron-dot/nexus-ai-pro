# ================================================
# Nexus AI Pro v3.0.0 — Environment Configuration
# Created: 2026-06-11
# Copy to .env — NEVER commit .env to source control
# Generate secrets: openssl rand -hex 32
# ================================================

# ── Server ────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── Encryption (REQUIRED)
ENCRYPTION_SECRET=replace_with_openssl_rand_hex_32_output
ENCRYPTION_SALT=replace_with_another_openssl_rand_hex_32_output
JWT_SECRET=replace_with_openssl_rand_hex_64_output
JWT_REFRESH_SECRET=replace_with_another_openssl_rand_hex_64_output
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql://nexus:yourpassword@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ── AI Providers ──────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=

# ── Payments — Stripe ─────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── Payments — Crypto (Coinbase Commerce) ─────────
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

# ── Social Platforms ──────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ── Gaming Platforms ──────────────────────────────
EPIC_GAMES_CLIENT_ID=
EPIC_GAMES_CLIENT_SECRET=
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
PSN_CLIENT_ID=
PSN_CLIENT_SECRET=
UBISOFT_APP_ID=
UBISOFT_APP_SECRET=
STEAM_API_KEY=

# ── Dev Integrations ──────────────────────────────
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SECRET_TOKEN=

# ── Cloud Providers ───────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=nexus-ai-pro-uploads
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_STORAGE_CONNECTION_STRING=
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=

# ── Email (SMTP) ──────────────────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@nexusai.pro

# ── MFA ───────────────────────────────────────────
MFA_ISSUER=NexusAIPro
MFA_TOKEN_WINDOW=1

# ── Monitoring ────────────────────────────────────
GRAFANA_PASSWORD=

# ── Apple (iOS) ───────────────────────────────────
APPLE_ID=
APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
