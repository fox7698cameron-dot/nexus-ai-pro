# ================================================
# NEXUS AI PRO - Environment Configuration
# Date: 2026-05-07
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# Generate secrets: openssl rand -hex 32
# ================================================

# ── Server ──────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── Security (generate with: openssl rand -hex 32) ──
ENCRYPTION_SECRET=generate_a_secure_random_string_here
ENCRYPTION_SALT=generate_another_secure_random_string_here
JWT_SECRET=generate_jwt_secret_here
JWT_REFRESH_SECRET=generate_jwt_refresh_secret_here
ELECTRON_STORE_KEY=generate_electron_store_key_here

# ── AI Model API Keys ────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ── Stripe Payments ──────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from your Stripe dashboard
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── Crypto Payments ──────────────────────────────
# Wallet addresses for receiving crypto
CRYPTO_WALLET_BTC=your_btc_wallet_address
CRYPTO_WALLET_ETH=your_eth_wallet_address
CRYPTO_WALLET_USDC=your_usdc_wallet_address

# ── Azure ────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER=nexus-ai-pro
AZURE_CLIENT_ID=your_azure_client_id
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_SECRET=your_azure_client_secret

# ── AWS ──────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=nexus-ai-pro

# ── Slack ────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_ALERT_CHANNEL=#alerts

# ── GitHub ───────────────────────────────────────
GITHUB_TOKEN=ghp_...

# ── Bitbucket ────────────────────────────────────
BITBUCKET_USERNAME=your_bitbucket_username
BITBUCKET_APP_PASSWORD=your_bitbucket_app_password

# ── Zoom ─────────────────────────────────────────
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# ── Adobe ────────────────────────────────────────
ADOBE_CLIENT_ID=your_adobe_client_id
ADOBE_CLIENT_SECRET=your_adobe_client_secret
ADOBE_PDF_SERVICES_CLIENT_ID=your_pdf_services_client_id

# ── Gaming Platform OAuth ────────────────────────
SONY_CLIENT_ID=your_sony_client_id
SONY_CLIENT_SECRET=your_sony_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
UBISOFT_CLIENT_ID=your_ubisoft_client_id
UBISOFT_CLIENT_SECRET=your_ubisoft_client_secret
EPIC_GAMES_CLIENT_ID=your_epic_games_client_id
EPIC_GAMES_CLIENT_SECRET=your_epic_games_client_secret

# ── Social Analytics Platform Tokens ────────────
# NOTE: These tokens are managed server-side via OAuth flows.
# Never expose them to the browser.
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# ── Deployment ───────────────────────────────────
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# ── Apple Developer (iOS) ────────────────────────
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# ── Monitoring ───────────────────────────────────
GRAFANA_PASSWORD=secure_grafana_password
