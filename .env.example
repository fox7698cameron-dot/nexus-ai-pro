# ================================================
# NEXUS AI PRO - Environment Configuration
# Copy this file to .env and fill in your values
# ================================================

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# AI Model API Keys
# Get your keys from the respective providers
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# Security - Generate secure random values
# openssl rand -hex 32
ENCRYPTION_SECRET=generate_a_secure_random_string_here
ENCRYPTION_SALT=generate_another_secure_random_string_here
JWT_SECRET=generate_jwt_secret_here

# Database (for production)
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# Deployment
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# Apple Developer (for iOS deployment)
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# Monitoring
GRAFANA_PASSWORD=secure_grafana_password

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url

# ── Payment (Stripe) ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...
# Client-side Stripe key (VITE_ prefix exposes to browser)
VITE_STRIPE_PUBLIC_KEY=pk_live_...

# ── Crypto Payments (Coinbase Commerce) ──────────────────────────────
COINBASE_COMMERCE_API_KEY=your_coinbase_commerce_key
# Client-side (optional)
VITE_COINBASE_COMMERCE_KEY=your_coinbase_commerce_key

# ── Translation (pick one) ────────────────────────────────────────────
GOOGLE_TRANSLATE_API_KEY=your_google_translate_key
# OR
DEEPL_API_KEY=your_deepl_api_key
# Client-side translate endpoint (optional)
VITE_TRANSLATE_API_URL=https://your-api.example.com

# ── Analytics APIs ─────────────────────────────────────────────────────
VITE_ANALYTICS_API_URL=https://your-analytics-api.example.com
VITE_ANALYTICS_API_KEY=your_analytics_api_key

# ── Cloud Connectors ──────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1

AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret

GOOGLE_CLOUD_API_KEY=your_google_cloud_key
GOOGLE_CLOUD_PROJECT_ID=your_project_id

ADOBE_CLIENT_ID=your_adobe_client_id
ADOBE_CLIENT_SECRET=your_adobe_client_secret

# ── Collaboration Connectors ──────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
GITHUB_TOKEN=ghp_...
BITBUCKET_ACCESS_TOKEN=your_bitbucket_token
ZOOM_ACCOUNT_ID=your_zoom_account
ZOOM_CLIENT_ID=your_zoom_client
ZOOM_CLIENT_SECRET=your_zoom_secret

# ── Game Platform Connectors ──────────────────────────────────────────
EPIC_GAMES_CLIENT_ID=your_epic_client_id
EPIC_GAMES_CLIENT_SECRET=your_epic_secret
SONY_PSN_NPSSO=your_psn_npsso
XBOX_CLIENT_ID=your_xbox_client
XBOX_CLIENT_SECRET=your_xbox_secret
UBISOFT_APP_ID=your_ubisoft_app
UBISOFT_APP_SECRET=your_ubisoft_secret

# ── Blob / Object Storage ─────────────────────────────────────────────
BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
BLOB_BUCKET=nexus-assets
