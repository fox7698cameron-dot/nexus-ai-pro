# ================================================
# NEXUS AI PRO - Environment Configuration
# 2026-07-20
# Copy this file to .env and fill in your values
# NEVER commit .env with real values to version control
# Generate secrets: openssl rand -hex 32
# ================================================

# ---- Server ----
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ---- Security (generate all with: openssl rand -hex 32) ----
ENCRYPTION_SECRET=
ENCRYPTION_SALT=
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ---- AI Providers ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=

# ---- Payments (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

# ---- Social Analytics (obtain from each platform's developer portal) ----
