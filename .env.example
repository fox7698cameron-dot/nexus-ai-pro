# ================================================
# NEXUS AI PRO - Environment Configuration
# Updated: 2026-10-11
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# Generate secrets with: openssl rand -hex 32
# ================================================

# ── Server ──────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── AI Model API Keys ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
DEEPSEEK_API_KEY=your_deepseek_key
XAI_API_KEY=your_xai_key
MISTRAL_API_KEY=your_mistral_key
MOONSHOT_API_KEY=your_moonshot_key

# ── Security (generate with: openssl rand -hex 32) ──
ENCRYPTION_SECRET=generate_64_char_hex_here
ENCRYPTION_SALT=generate_64_char_hex_here
JWT_SECRET=generate_64_char_hex_here
JWT_REFRESH_SECRET=generate_64_char_hex_here
SESSION_SECRET=generate_64_char_hex_here

# ── WebAuthn / Biometrics ────────────────────────
WEBAUTHN_RP_NAME=Nexus AI Pro
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# ── Payments ─────────────────────────────────────
# Stripe (test keys: sk_test_..., pk_test_...)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Crypto payments
CRYPTO_PAYMENT_BTC_ADDRESS=your_btc_wallet
CRYPTO_PAYMENT_ETH_ADDRESS=your_eth_wallet

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379
BLOB_STORAGE_URL=your_blob_storage_connection_string

# ── Cloud Integrations ───────────────────────────
# Azure
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
# AWS
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project
# Slack
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# GitHub
GITHUB_CLIENT_ID=your_github_oauth_app_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_secret
# Bitbucket
BITBUCKET_CLIENT_ID=your_bitbucket_key
BITBUCKET_CLIENT_SECRET=your_bitbucket_secret
# Zoom
ZOOM_CLIENT_ID=your_zoom_key
ZOOM_CLIENT_SECRET=your_zoom_secret

# ── Social Analytics ─────────────────────────────
TIKTOK_CLIENT_KEY=your_tiktok_key
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_secret
TWITCH_CLIENT_ID=your_twitch_id
TWITCH_CLIENT_SECRET=your_twitch_secret
REDDIT_CLIENT_ID=your_reddit_id
REDDIT_CLIENT_SECRET=your_reddit_secret
DISCORD_CLIENT_ID=your_discord_id
DISCORD_CLIENT_SECRET=your_discord_secret

# ── Game Platform Connectors ─────────────────────
EPIC_GAMES_CLIENT_ID=your_epic_id
EPIC_GAMES_CLIENT_SECRET=your_epic_secret
STEAM_API_KEY=your_steam_key
UBISOFT_APP_ID=your_ubisoft_id

# ── Email (MFA codes, password reset) ────────────
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@nexusai.pro

# ── SMS (MFA) ────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1...

# ── Deployment ───────────────────────────────────
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# ── Apple Developer (iOS) ────────────────────────
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# ── Monitoring ───────────────────────────────────
GRAFANA_PASSWORD=generate_secure_password_here
SENTRY_DSN=https://...@sentry.io/...
