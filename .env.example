# ================================================
# NEXUS AI PRO - Environment Configuration
# Updated: 2026-08-12
# Copyright © 2025-2026 Cameron Fox. All rights reserved.
#
# SECURITY: Never commit actual values to version control.
# Copy this file to .env and fill in your values.
# Generate secrets with: openssl rand -hex 32
# ================================================

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
APP_NAME=Nexus AI Pro
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_ISSUER=nexus-ai-pro
JWT_AUDIENCE=nexus-ai-pro-client

# ─── Encryption ───────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
ENCRYPTION_SALT=REPLACE_WITH_OPENSSL_RAND_HEX_64

# ─── Privileged Account Registration ─────────────────────────────────────────
# Required invite code for admin/dev/moderator registration
INVITE_CODE=REPLACE_WITH_SECURE_INVITE_CODE

# ─── WebAuthn (Biometrics) ────────────────────────────────────────────────────
RP_ID=localhost

# ─── AI Model API Keys ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=

# ─── Stripe Payments ──────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ─── Blob Storage ────────────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Cloud Connector OAuth ────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ─── Gaming Platform Credentials ─────────────────────────────────────────────
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
# Sony, Microsoft, Ubisoft: configure via admin connector UI

# ─── Social Media OAuth ───────────────────────────────────────────────────────
# Configure each platform's OAuth in the Analytics Connector UI
# These are per-user tokens, not global app-level keys

# ─── i18n / Auto-Translate ───────────────────────────────────────────────────
VITE_TRANSLATE_ENDPOINT=
# Example: https://libretranslate.yourdomain.com/translate
# (self-hosted LibreTranslate, DeepL, or other translate API)

# ─── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# ─── Deployment ───────────────────────────────────────────────────────────────
VERCEL_TOKEN=
RAILWAY_TOKEN=

# ─── Apple Developer (iOS) ────────────────────────────────────────────────────
APPLE_ID=
APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
