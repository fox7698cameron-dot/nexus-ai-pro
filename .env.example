# ================================================
# NEXUS AI PRO — Environment Configuration
# Labeled: 2026-08-25
#
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER hardcode any of these values in source code.
# Generate secrets with: openssl rand -hex 32
# ================================================

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# ── JWT & Encryption ─────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=
JWT_ISSUER=nexus-ai-pro
JWT_AUDIENCE=nexus-ai-pro-client

# Generate: openssl rand -hex 32
ENCRYPTION_SECRET=
ENCRYPTION_SALT=

# ── AI Model API Keys ─────────────────────────────────────────────────────────
# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT-4, GPT-5, DALL-E)
OPENAI_API_KEY=

# Google (Gemini, Translation)
GOOGLE_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_CLOUD_PROJECT=

# DeepSeek
DEEPSEEK_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# Moonshot
MOONSHOT_API_KEY=

# ── Stripe Payments ───────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs from your Stripe dashboard
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ── Cryptocurrency (Coinbase Commerce) ────────────────────────────────────────
# Get from https://commerce.coinbase.com/settings/api
COINBASE_COMMERCE_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379
BLOB_STORAGE_URL=

# ── Cloud Connectors ──────────────────────────────────────────────────────────

# Microsoft Azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Amazon AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Adobe Creative Cloud
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_WEBHOOK_URL=

# Zoom
ZOOM_API_KEY=
ZOOM_API_SECRET=

# GitHub
GITHUB_TOKEN=

# Bitbucket
BITBUCKET_TOKEN=
BITBUCKET_WORKSPACE=

# ── Game Platform Connectors ──────────────────────────────────────────────────

# Epic Games / Unreal Engine
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_DEPLOYMENT_ID=

# Sony PlayStation Network
SONY_APP_ID=
SONY_APP_SECRET=

# Microsoft Xbox Live
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Ubisoft Connect
UBISOFT_APP_ID=
UBISOFT_APP_SECRET=

# Steam Web API
STEAM_WEB_API_KEY=

# ── Social Platform Analytics (OAuth or API keys) ─────────────────────────────
# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram / Facebook (Meta)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Deployment ────────────────────────────────────────────────────────────────
VERCEL_TOKEN=
RAILWAY_TOKEN=

# ── Apple Developer (iOS) ─────────────────────────────────────────────────────
APPLE_ID=
APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=

# ── 2FA / Email / SMS ─────────────────────────────────────────────────────────
# For sending OTP codes (Twilio, SendGrid, etc.)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SENDGRID_API_KEY=
EMAIL_FROM=noreply@nexusai.pro
