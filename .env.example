# ================================================
# NEXUS AI PRO — Environment Configuration
# Copy to .env and fill in your values.
# NEVER commit .env to source control.
# NEVER hard-code secrets in source files.
# ================================================

# ── Server ───────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:3001

# ── AI Model API Keys ─────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_grok_api_key
MISTRAL_API_KEY=your_mistral_api_key

# ── Security (generate with: openssl rand -hex 32) ──
ENCRYPTION_SECRET=generate_32_byte_hex_string_here
ENCRYPTION_SALT=generate_another_32_byte_hex_string_here
JWT_SECRET=generate_jwt_secret_here_at_least_32_chars

# ── Stripe Payments ────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRICE_PRO_MONTHLY=price_your_pro_monthly_price_id
STRIPE_PRICE_PRO_ANNUAL=price_your_pro_annual_price_id
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_your_enterprise_monthly_price_id
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_your_enterprise_annual_price_id

# ── Database ───────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ── Azure ─────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
AZURE_BLOB_CONTAINER=nexus-uploads
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=gpt-4

# ── AWS ───────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=nexus-ai-pro-uploads
AWS_SES_FROM_EMAIL=noreply@nexusaipro.com

# ── Google Cloud ───────────────────────────────────
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key
GOOGLE_NL_API_KEY=your_google_nl_api_key
GOOGLE_TTS_API_KEY=your_google_tts_api_key

# ── Slack ──────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook

# ── Zoom ──────────────────────────────────────────
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# ── GitHub ─────────────────────────────────────────
GITHUB_API_TOKEN=ghp_your_github_personal_access_token

# ── Bitbucket ─────────────────────────────────────
BITBUCKET_USERNAME=your_bitbucket_username
BITBUCKET_APP_PASSWORD=your_bitbucket_app_password

# ── Adobe ─────────────────────────────────────────
ADOBE_CLIENT_ID=your_adobe_client_id
ADOBE_CLIENT_SECRET=your_adobe_client_secret
ADOBE_ORG_ID=your_adobe_org_id

# ── Gaming Platforms ────────────────────────────────
EPIC_CLIENT_ID=your_epic_games_client_id
EPIC_CLIENT_SECRET=your_epic_games_client_secret
STEAM_API_KEY=your_steam_api_key
UBISOFT_APP_ID=afb4b43c-f1f7-41b7-bcef-a635d8c83822

# ── Translation ────────────────────────────────────
DEEPL_API_KEY=your_deepl_api_key

# ── Social Media Analytics ─────────────────────────
# Credentials stored per-user via /api/analytics/credentials
# TikTok: access_token, userId
# Instagram: access_token, userId
# Facebook: access_token, pageId
# Twitch: clientId, accessToken, broadcasterId
# Discord: botToken, guildId
# Reddit: accessToken, subreddit or username
# RedGifs: accessToken (optional), userId

# ── Apple Developer (iOS deployment) ───────────────
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# ── Unity Cloud Build ──────────────────────────────
UNITY_CLOUD_API_KEY=your_unity_cloud_build_api_key

# ── Monitoring ─────────────────────────────────────
GRAFANA_PASSWORD=secure_grafana_password_here
