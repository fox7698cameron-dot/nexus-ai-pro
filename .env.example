# ================================================
# NEXUS AI PRO - Environment Variable Template
# 2026-08-02
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# All secrets must come from environment variables,
# a secrets manager (Azure Key Vault, AWS Secrets Manager, etc.)
# or a CI/CD vault. No hardcoded secrets in code.
# ================================================

# ── Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── Encryption (generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
ENCRYPTION_SECRET=
ENCRYPTION_SALT=

# ── JWT Authentication
JWT_SECRET=
JWT_EXPIRES=24h
JWT_REFRESH_EXPIRES=7d

# ── AI Model APIs (all optional — only enable what you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=

# ── Stripe Payments (never hardcode — load from env/vault only)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Database
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://user:pass@localhost:5432/nexusai

# ── Blob / Object Storage
BLOB_STORAGE_URL=
BLOB_STORAGE_KEY=

# ── Cloud Providers
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Integrations
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GITHUB_TOKEN=
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=

# ── Game Dev SDKs
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
SONY_NP_CLIENT_ID=
XBOX_CLIENT_ID=
UBISOFT_APP_ID=

# ── Apple Developer (iOS deployment)
APPLE_ID=
APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# ── Monitoring
GRAFANA_PASSWORD=
VERCEL_TOKEN=
RAILWAY_TOKEN=
