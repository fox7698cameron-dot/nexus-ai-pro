# ================================================
# NEXUS AI PRO - Environment Configuration
# Updated: 2026-10-16
# Copy this file to .env and fill in your values.
# NEVER hard-code secrets in source code.
# ================================================

# ── Server ────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# ── AI Model API Keys ─────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key

# ── Security (generate with: openssl rand -hex 32) ─
ENCRYPTION_SECRET=generate_a_secure_random_string_here
ENCRYPTION_SALT=generate_another_secure_random_string_here
JWT_SECRET=generate_jwt_secret_here

# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Blob Storage ─────────────────────────────────
BLOB_STORAGE_URL=
BLOB_STORAGE_KEY=

# ── Payments (Stripe) ─────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Crypto Payments ───────────────────────────────
COINGATE_API_KEY=your_coingate_api_key

# ── Cloud Connectors ─────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=

# ── Creative ──────────────────────────────────────
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=

# ── Communications ────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

ZOOM_API_KEY=
ZOOM_API_SECRET=

# ── Dev Tools ────────────────────────────────────
GITHUB_TOKEN=
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# ── Game Platforms ───────────────────────────────
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=

PSN_API_KEY=
PSN_CLIENT_SECRET=

XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=

UBISOFT_APP_ID=
UBISOFT_APP_SECRET=

# ── Translation ──────────────────────────────────
GOOGLE_TRANSLATE_API_KEY=

# ── Apple Developer (iOS) ─────────────────────────
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# ── Deployment ────────────────────────────────────
VERCEL_TOKEN=
RAILWAY_TOKEN=

# ── Monitoring ───────────────────────────────────
GRAFANA_PASSWORD=secure_grafana_password
