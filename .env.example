# ================================================
# NEXUS AI PRO - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to source control
# Generate secrets: openssl rand -hex 32
# File: .env.example | Last updated: 2026-05-09
# ================================================

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# AI Model API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# Security - Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=replace_with_openssl_rand_hex_32
ENCRYPTION_SALT=replace_with_openssl_rand_hex_32
JWT_SECRET=replace_with_openssl_rand_hex_32

# Database (production)
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# Stripe Payments (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_your_pro_plan_id
STRIPE_ENT_PRICE_ID=price_your_enterprise_plan_id

# Game Platform API Keys
EPIC_API_KEY=your_epic_games_api_key
EPIC_API_URL=https://api.epicgames.com
SONY_API_KEY=your_sony_psn_api_key
SONY_API_URL=https://api.np.km.playstation.net
MICROSOFT_API_KEY=your_xbox_live_api_key
MICROSOFT_API_URL=https://xboxlive.com/api
UBISOFT_API_KEY=your_ubisoft_connect_api_key
UBISOFT_API_URL=https://public-ubiservices.ubi.com

# Cloud Connectors
AZURE_API_KEY=your_azure_subscription_key
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
ADOBE_API_KEY=your_adobe_api_key
SLACK_TOKEN=your_slack_bot_token
SLACK_WEBHOOK_URL=your_slack_webhook_url
ZOOM_API_KEY=your_zoom_api_key
ZOOM_API_SECRET=your_zoom_api_secret
GITHUB_TOKEN=your_github_personal_access_token
BITBUCKET_TOKEN=your_bitbucket_app_password

# Social Analytics (connect via OAuth in production)
TIKTOK_API_KEY=your_tiktok_api_key
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_token
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Deployment
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# Apple Developer (iOS deployment)
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# Monitoring
GRAFANA_PASSWORD=secure_grafana_password
