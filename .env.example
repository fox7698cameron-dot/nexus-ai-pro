# ================================================
# NEXUS AI PRO - Environment Configuration
# Updated: 2026-08-24
# Copy this file to .env and fill in your values
# NEVER commit .env to source control
# Generate secrets: openssl rand -hex 32
# ================================================

# ─── Server ────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ─── AI Model API Keys ──────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# ─── Security (generate all with: openssl rand -hex 32) ──
ENCRYPTION_SECRET=generate_a_secure_random_string_min_32_chars
ENCRYPTION_SALT=generate_another_secure_random_string_min_64_chars
JWT_SECRET=generate_jwt_secret_min_32_chars_here
JWT_REFRESH_SECRET=generate_jwt_refresh_secret_different_from_above

# ─── SSL (production) ──────────────────────────────
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# ─── Database ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ─── Stripe Payments ───────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx
STRIPE_PRICE_ENT_MONTHLY=price_xxx
STRIPE_PRICE_ENT_ANNUAL=price_xxx

# ─── Crypto Payment Addresses ──────────────────────
# Your wallet addresses for receiving crypto
CRYPTO_BTC_ADDRESS=your_bitcoin_wallet_address
CRYPTO_ETH_ADDRESS=your_ethereum_wallet_address
CRYPTO_USDC_ADDRESS=your_usdc_wallet_address
CRYPTO_SOL_ADDRESS=your_solana_wallet_address
CRYPTO_BNB_ADDRESS=your_bnb_wallet_address
CRYPTO_MATIC_ADDRESS=your_polygon_wallet_address

# ─── Social Analytics ──────────────────────────────
TIKTOK_CLIENT_ID=your_tiktok_client_id
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
INSTAGRAM_CLIENT_ID=your_instagram_app_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_ACCESS_TOKEN=your_twitch_oauth_token
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_BOT_TOKEN=your_discord_bot_token
LEMON8_CLIENT_ID=your_lemon8_client_id
LEMON8_ACCESS_TOKEN=your_lemon8_access_token
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_ACCESS_TOKEN=your_reddit_access_token
REDGIFS_CLIENT_ID=your_redgifs_client_id
REDGIFS_ACCESS_TOKEN=your_redgifs_access_token

# ─── Translation ───────────────────────────────────
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# ─── Game Dev Platform Connectors ──────────────────
UNREAL_API_KEY=your_unreal_engine_api_key
UNREAL_ENGINE_VERSION=5.4
EPIC_CLIENT_ID=your_epic_games_client_id
EPIC_CLIENT_SECRET=your_epic_games_client_secret
SONY_PSN_ACCESS_TOKEN=your_psn_access_token
XBOX_ACCESS_TOKEN=your_xbox_developer_access_token
UBISOFT_ACCESS_TOKEN=your_ubisoft_connect_access_token
UNITY_ACCESS_TOKEN=your_unity_access_token

# ─── Cloud Storage ─────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-nexus-ai-pro-bucket

# ─── Azure ─────────────────────────────────────────
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_STORAGE_ACCOUNT=your_storage_account_name
AZURE_BLOB_CONTAINER=nexus-ai-pro

# ─── Google Cloud ──────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ─── Adobe ─────────────────────────────────────────
ADOBE_CLIENT_ID=your_adobe_client_id
ADOBE_CLIENT_SECRET=your_adobe_client_secret

# ─── GitHub / Bitbucket ────────────────────────────
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_ACCESS_TOKEN=your_github_personal_access_token
BITBUCKET_CLIENT_ID=your_bitbucket_oauth_client_id
BITBUCKET_CLIENT_SECRET=your_bitbucket_oauth_client_secret

# ─── Slack ─────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_CLIENT_ID=your_slack_app_client_id
SLACK_CLIENT_SECRET=your_slack_app_client_secret
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# ─── Zoom ──────────────────────────────────────────
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# ─── Apple Developer (iOS/macOS) ───────────────────
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# ─── Rate Limiting ─────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# ─── Deployment ────────────────────────────────────
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# ─── Monitoring ────────────────────────────────────
GRAFANA_PASSWORD=secure_grafana_password
