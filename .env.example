# ================================================
# NEXUS AI PRO - Environment Configuration
# Date: 2026-07-08
# Copy this file to .env and fill in real values
# NEVER commit .env to source control
# ================================================

# ── Core Auth (required) ──────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex
JWT_REFRESH_SECRET=replace_with_different_64_byte_random_hex

# ── Encryption (required) ─────────────────────────────────────────────────────
ENCRYPTION_SECRET=replace_with_64_hex_chars
ENCRYPTION_SALT=replace_with_32_hex_chars

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# ── Redis (optional — caching; leave blank to disable) ───────────────────────
REDIS_URL=redis://localhost:6379

# ── AI Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
GOOGLE_TRANSLATE_API_KEY=AIza...
XAI_API_KEY=xai-...
DEEPSEEK_API_KEY=...
MISTRAL_API_KEY=...
MOONSHOT_API_KEY=...

# ── Stripe (required for billing) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_...
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_...

# ── Crypto Payment Wallets (optional) ────────────────────────────────────────
CRYPTO_BTC_ADDRESS=
CRYPTO_ETH_ADDRESS=
CRYPTO_USDC_ADDRESS=
CRYPTO_USDT_ADDRESS=
CRYPTO_SOL_ADDRESS=
CRYPTO_MATIC_ADDRESS=

# ── Integrations ─────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── AWS S3 / Blob Storage (optional) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=nexus-ai-pro-uploads

# ── Database (optional — for production SQL persistence) ─────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai

# ── Deployment ────────────────────────────────────────────────────────────────
VERCEL_TOKEN=
RAILWAY_TOKEN=

# ── Apple Developer (for iOS deployment) ─────────────────────────────────────
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id
