# ================================================
# NEXUS AI PRO - Environment Configuration
# Copy this file to .env and fill in your values
# ================================================

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# AI Model API Keys
# Get your keys from the respective providers
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# Security - Generate secure random values
# openssl rand -hex 32
ENCRYPTION_SECRET=generate_a_secure_random_string_here
ENCRYPTION_SALT=generate_another_secure_random_string_here
JWT_SECRET=generate_jwt_secret_here

# Database (for production)
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# Deployment
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# Apple Developer (for iOS deployment)
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# Monitoring
GRAFANA_PASSWORD=secure_grafana_password

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url

# ================================================
# NEW FEATURES - 2026-10-12
# ================================================

# Application URL (for OAuth callbacks and payment redirects)
APP_URL=https://your-domain.com

# Auth - Invite codes for elevated roles (optional, required for elevated registration)
INVITE_CODE_ADMIN=generate_secure_invite_code
INVITE_CODE_DEVELOPER=generate_secure_invite_code
INVITE_CODE_MODERATOR=generate_secure_invite_code

# Stripe Payments
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Crypto Payments (e.g., NOWPayments, Coinbase Commerce)
CRYPTO_PROCESSOR_API_KEY=your_crypto_processor_api_key
CRYPTO_PROCESSOR_WEBHOOK_SECRET=your_crypto_webhook_secret

# Social Media Analytics - Platform OAuth Credentials
# Get from each platform's developer portal
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_WEBHOOK_SECRET=your_tiktok_webhook_secret

INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_WEBHOOK_SECRET=your_instagram_webhook_secret

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_WEBHOOK_SECRET=your_facebook_webhook_secret

TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CLIENT_SECRET=your_discord_client_secret

REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

LEMON8_API_KEY=your_lemon8_api_key
REDGIFS_API_KEY=your_redgifs_api_key

# Game Dev Platform Credentials
EPIC_CLIENT_ID=your_epic_games_client_id
EPIC_CLIENT_SECRET=your_epic_games_client_secret

PLAYSTATION_CLIENT_ID=your_psn_client_id
PLAYSTATION_CLIENT_SECRET=your_psn_client_secret

XBOX_CLIENT_ID=your_xbox_client_id
XBOX_CLIENT_SECRET=your_xbox_client_secret

UBISOFT_CLIENT_ID=your_ubisoft_client_id
UBISOFT_CLIENT_SECRET=your_ubisoft_client_secret

STEAM_API_KEY=your_steam_web_api_key

# External Service Integrations
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
BITBUCKET_OAUTH_CLIENT_ID=your_bitbucket_client_id
BITBUCKET_OAUTH_CLIENT_SECRET=your_bitbucket_client_secret
ADOBE_CLIENT_ID=your_adobe_client_id
ADOBE_CLIENT_SECRET=your_adobe_client_secret

# Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
AWS_S3_BUCKET=your_s3_bucket_name

# CI/CD Webhook Secrets (for project tracking)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
BITBUCKET_WEBHOOK_SECRET=your_bitbucket_webhook_secret
