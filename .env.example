# ================================================
# NEXUS AI PRO - Environment Variables
# File: .env.example
# Date: 2026-08-26
#
# Copy to .env and fill in values.
# NEVER commit .env with real secrets.
# ================================================

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173

# ─── Security / Cryptography (generate with: openssl rand -hex 64) ────────────
ENCRYPTION_SECRET=CHANGE_ME_openssl_rand_hex_64
ENCRYPTION_SALT=CHANGE_ME_openssl_rand_hex_64
ENUM_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_64
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_64
BIOMETRIC_SECRET=CHANGE_ME_openssl_rand_hex_32

# ─── AI Model API Keys ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379
REDIS_TLS_URL=

# ─── Blob Storage ─────────────────────────────────────────────────────────────
# Azure Blob
AZURE_STORAGE_CONNECTION_STRING=
# AWS S3
S3_BUCKET=
# Google Cloud Storage
GCS_BUCKET=

# ─── Payments / Stripe ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ─── Crypto Payments (Coinbase Commerce) ──────────────────────────────────────
COINBASE_COMMERCE_API_KEY=
COINBASE_WEBHOOK_SECRET=

# ─── Analytics - Social Platforms ─────────────────────────────────────────────
TIKTOK_API_KEY=
TIKTOK_API_SECRET=
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_CHANNEL_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_CHANNEL_ID=
TWITCH_API_KEY=
TWITCH_ACCESS_TOKEN=
TWITCH_CHANNEL_ID=
DISCORD_ACCESS_TOKEN=
DISCORD_CHANNEL_ID=
REDDIT_ACCESS_TOKEN=
REDDIT_CHANNEL_ID=

# ─── Cloud Connectors ─────────────────────────────────────────────────────────
# Azure
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=eastus

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Google
GOOGLE_TRANSLATE_API_KEY=

# ─── Developer Connectors ─────────────────────────────────────────────────────
# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_WEBHOOK_URL=

# Zoom
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# GitHub
GITHUB_TOKEN=ghp_...

# Bitbucket
BITBUCKET_USER=
BITBUCKET_APP_PASSWORD=

# ─── Translation ──────────────────────────────────────────────────────────────
DEEPL_API_KEY=

# ─── Deployment ───────────────────────────────────────────────────────────────
VERCEL_TOKEN=
RAILWAY_TOKEN=

# ─── iOS / Apple ──────────────────────────────────────────────────────────────
APPLE_ID=your@apple.id
APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# ─── Machine-to-machine API keys (comma separated hashed values) ───────────────
API_KEYS=

# ─── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=
