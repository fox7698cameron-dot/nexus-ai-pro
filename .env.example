# ================================================
# NEXUS AI PRO - Environment Configuration
# 2026-08-10 | Version 2.1.0
# Copy this file to .env and fill in your values
# NEVER commit real secrets to version control
# Generate random values: openssl rand -hex 32
# ================================================

# ── Server ──────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── Security (required — generate with: openssl rand -hex 32) ──
ENCRYPTION_SECRET=
ENCRYPTION_SALT=
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=

# ── AI Model API Keys ────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379
BLOB_STORAGE_URL=

# ── Payment (Stripe) ─────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# ── Cloud Providers ──────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
