# ================================================
# NEXUS AI PRO - Environment Configuration
# 2026-06-12 | Copy this file to .env and fill in values
# NEVER commit .env to version control
# Generate secrets: openssl rand -hex 32
# ================================================

# ---- Server ----
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ---- AI Model API Keys ----
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# ---- Security (generate with: openssl rand -hex 32) ----
ENCRYPTION_SECRET=generate_a_secure_random_string_here
ENCRYPTION_SALT=generate_another_secure_random_string_here
JWT_SECRET=generate_jwt_secret_here

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ---- Stripe Payments ----
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_PRO=price_your_pro_price_id
STRIPE_PRICE_ENTERPRISE=price_your_enterprise_price_id

# ---- Crypto Payment Addresses (your wallet addresses) ----
CRYPTO_BTC_ADDRESS=
CRYPTO_ETH_ADDRESS=
CRYPTO_USDC_ADDRESS=
CRYPTO_USDT_ADDRESS=
CRYPTO_SOL_ADDRESS=
CRYPTO_LTC_ADDRESS=
CRYPTO_MATIC_ADDRESS=

# ---- Cloud Providers ----
# Azure
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_BLOB_CONNECTION_STRING=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Google Cloud
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=

# ---- Developer Tools ----
GITHUB_TOKEN=
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# ---- Communication ----
SLACK_WEBHOOK_URL=your_slack_webhook_url
SLACK_BOT_TOKEN=
ZOOM_API_KEY=
ZOOM_API_SECRET=
DISCORD_BOT_TOKEN=

# ---- Creative ----
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=

# ---- Game Platforms ----
EPIC_GAMES_CLIENT_ID=
EPIC_GAMES_CLIENT_SECRET=
SONY_PSN_CLIENT_ID=
SONY_PSN_CLIENT_SECRET=
MICROSOFT_XBOX_CLIENT_ID=
MICROSOFT_XBOX_CLIENT_SECRET=
UBISOFT_APP_ID=
UBISOFT_API_KEY=
STEAM_API_KEY=

# ---- Deployment ----
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# ---- Apple Developer (iOS) ----
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# ---- Monitoring ----
GRAFANA_PASSWORD=secure_grafana_password
