# ================================================
# NEXUS AI PRO — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# Generate secrets: openssl rand -hex 32
# ================================================

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── Security (generate all with: openssl rand -hex 32) ───────────────────────
ENCRYPTION_SECRET=<openssl rand -hex 32>
ENCRYPTION_SALT=<openssl rand -hex 64>
JWT_SECRET=<openssl rand -hex 32>

# ── AI Model API Keys ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
DEEPSEEK_API_KEY=sk-...
XAI_API_KEY=xai-...
MISTRAL_API_KEY=...
MOONSHOT_API_KEY=...

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_ENT_MONTHLY_PRICE_ID=price_...
STRIPE_ENT_YEARLY_PRICE_ID=price_...

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379
BLOB_STORAGE_URL=azureblob://account:key@container

# ── Cloud Providers ────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AZURE_SUBSCRIPTION_ID=...
AZURE_CLIENT_ID=...
AZURE_CLIENT_SECRET=...
AZURE_TENANT_ID=...
GOOGLE_CLOUD_PROJECT=...

# ── Social Media Analytics ────────────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=...
INSTAGRAM_ACCESS_TOKEN=...
FACEBOOK_ACCESS_TOKEN=...
TWITCH_CLIENT_ID=...
TWITCH_ACCESS_TOKEN=...
DISCORD_BOT_TOKEN=Bot ...
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
LEMON8_ACCESS_TOKEN=...
REDGIFS_API_KEY=...

# ── Developer Tools ────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
BITBUCKET_TOKEN=...

# ── Productivity ───────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
