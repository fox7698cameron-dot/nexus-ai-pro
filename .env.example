# ================================================
# NEXUS AI PRO - Environment Configuration
# 2026-07-22 | Copy to .env and fill in your values
# NEVER commit your .env file — it contains secrets
# Generate random secrets: openssl rand -hex 32
# ================================================

# ── Server ──────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=https://nexusai.pro
CORS_ORIGIN=https://nexusai.pro,https://app.nexusai.pro

# ── AI API Keys ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
DEEPSEEK_API_KEY=sk-...
XAI_API_KEY=xai-...
MISTRAL_API_KEY=...

# ── Security (required in production) ───────────
# openssl rand -hex 32
ENCRYPTION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX
ENCRYPTION_SALT=REPLACE_WITH_RANDOM_64_CHAR_HEX
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_64_CHAR_HEX

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql://nexusai:CHANGE_ME@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ── Stripe (payments) ────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── OAuth connectors ─────────────────────────────
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...
BITBUCKET_CLIENT_ID=...
BITBUCKET_CLIENT_SECRET=...
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...
ZOOM_CLIENT_ID=...
ZOOM_CLIENT_SECRET=...
AZURE_CLIENT_ID=...
AZURE_CLIENT_SECRET=...
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
ADOBE_CLIENT_ID=...
ADOBE_CLIENT_SECRET=...

# ── Game connectors ───────────────────────────────
EPIC_CLIENT_ID=...
EPIC_CLIENT_SECRET=...
SONY_CLIENT_ID=...
XBOX_CLIENT_ID=...
UBISOFT_CLIENT_ID=...

# ── Apple Developer (iOS) ─────────────────────────
APPLE_ID=your@email.com
APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX

# ── Deployment ───────────────────────────────────
VERCEL_TOKEN=...
RAILWAY_TOKEN=...

# ── Monitoring ───────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
