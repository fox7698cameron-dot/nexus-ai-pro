# ================================================
# NEXUS AI PRO - Environment Configuration
# Copy this file to .env and fill in your values
# ================================================

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# AI Model API Keys
# Get your keys from the respective providers
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# Security - Generate secure random values
# openssl rand -hex 32
ENCRYPTION_SECRET=generate_a_secure_random_string_here
ENCRYPTION_SALT=generate_another_secure_random_string_here
JWT_SECRET=generate_jwt_secret_here

# Database (for production)
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# Deployment
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# Apple Developer (for iOS deployment)
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# Monitoring
GRAFANA_PASSWORD=secure_grafana_password

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url

# Payment (get from Stripe dashboard - never hardcode)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Social Analytics (never hardcode actual keys)
TIKTOK_API_KEY=your_tiktok_key_here
INSTAGRAM_API_KEY=your_instagram_key_here
FACEBOOK_API_KEY=your_facebook_key_here
TWITCH_CLIENT_ID=your_twitch_client_id_here
DISCORD_BOT_TOKEN=your_discord_token_here

# Gaming Connectors (never hardcode)
EPIC_CLIENT_ID=your_epic_client_id_here
EPIC_CLIENT_SECRET=your_epic_client_secret_here
PSN_API_KEY=your_psn_api_key_here
XBOX_CLIENT_ID=your_xbox_client_id_here
UBISOFT_CLIENT_ID=your_ubisoft_client_id_here

# Translation API (never hardcode)
TRANSLATE_API_KEY=your_translate_api_key_here

# JWT (generate with: openssl rand -hex 64)
JWT_SECRET=generate_a_secure_64_char_hex_string_here
JWT_EXPIRY=24h

# MFA/2FA
MFA_ISSUER=NexusAIPro
TOTP_SECRET_SALT=generate_secure_random_salt_here

# Crypto Payments (never hardcode)
CRYPTO_GATEWAY_KEY=your_crypto_gateway_key_here
