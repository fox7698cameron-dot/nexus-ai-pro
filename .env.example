# ================================================
# NEXUS AI PRO — Environment Configuration v2.1
# Updated: 2026-05-03
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ================================================

# ── Server ──────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── AI Model API Keys ────────────────────────────
# Obtain from each provider's developer console
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=

# ── Security (generate with: openssl rand -hex 64)
ENCRYPTION_SECRET=
ENCRYPTION_SALT=
JWT_SECRET=

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql://nexus:changeme@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ── Stripe Payments ───────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ── Azure ────────────────────────────────────────
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ── AWS ───────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_SES_FROM=

# ── Google Cloud ──────────────────────────────────
GCP_PROJECT_ID=
GCP_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TRANSLATE_API_KEY=

# ── Slack ─────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=

# ── Zoom ──────────────────────────────────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ── GitHub ────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# ── Bitbucket ─────────────────────────────────────
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
BITBUCKET_WORKSPACE=

# ── Adobe ─────────────────────────────────────────
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_ORG_ID=

# ── Deployment ────────────────────────────────────
VERCEL_TOKEN=
RAILWAY_TOKEN=

# ── Apple Developer (iOS) ─────────────────────────
APPLE_ID=
APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# ── Monitoring ────────────────────────────────────
GRAFANA_PASSWORD=
