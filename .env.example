# ================================================
# NEXUS AI PRO - Environment Configuration
# Date: 2026-08-22
# Copyright © 2025-2026 Cameron Fox. All rights reserved.
#
# SECURITY: Never commit actual .env to version control.
# Copy this file to .env and fill in your real values.
# Generate secrets with: openssl rand -hex 64
# ================================================

# ── Server ────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=https://yourdomain.com

# ── Security (REQUIRED - generate strong random values) ──
# openssl rand -hex 64
ENCRYPTION_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
ENCRYPTION_SALT=REPLACE_WITH_64_CHAR_HEX_STRING
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING

# WebAuthn
WEBAUTHN_RP_ID=localhost

# ── AI Model API Keys ─────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=

# ── Payments - Stripe ─────────────────────────────
# Never hardcode these. Get from dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
# Stripe Price IDs (create in Stripe dashboard)
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_GAMEDEV=
STRIPE_PRICE_STUDIO=

# ── Payments - Crypto wallets ─────────────────────
CRYPTO_BTC_WALLET=
CRYPTO_ETH_WALLET=
CRYPTO_USDC_WALLET=
CRYPTO_USDT_WALLET=

# ── Social Media API Keys ─────────────────────────
TIKTOK_API_KEY=
TIKTOK_CLIENT_KEY=
INSTAGRAM_API_KEY=
INSTAGRAM_CLIENT_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
LEMON8_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=NexusAIPro/2.0
REDGIFS_API_KEY=

# ── Game Platform Connectors ─────────────────────
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
SONY_PARTNER_ID=
SONY_API_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
UBISOFT_APP_ID=
UBISOFT_API_KEY=
STEAM_PUBLISHER_KEY=
META_APP_ID=
META_APP_SECRET=

# ── Cloud Connectors ─────────────────────────────
# Azure
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_STORAGE_CONNECTION_STRING=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_PROJECT_ID=
GOOGLE_CLOUD_KEY_FILE=

# Adobe
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=

# Zoom
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# GitHub
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Bitbucket
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# ── Databases ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Blob Storage
BLOB_PROVIDER=aws
# Options: aws | azure | gcs

# ── Translation / i18n ───────────────────────────
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=
DEEPL_API_KEY=

# ── Email (for OTP/notifications) ────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@nexusai.pro
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── SMS (for OTP) ─────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Monitoring ───────────────────────────────────
GRAFANA_PASSWORD=
PROMETHEUS_URL=http://localhost:9090

# ── Deployment ───────────────────────────────────
VERCEL_TOKEN=
RAILWAY_TOKEN=

# ── Apple Developer (iOS) ─────────────────────────
APPLE_ID=
APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
