# ── Game Engines & Stores ─────────────────────────────────────────────────────
UNREAL_PROJECT_ID=...
EPIC_CLIENT_ID=...
EPIC_CLIENT_SECRET=...
PSN_CLIENT_ID=...
XBOX_CLIENT_ID=...
UBISOFT_CLIENT_ID=...

# ── Translation ────────────────────────────────────────────────────────────────
DEEPL_API_KEY=...
GOOGLE_TRANSLATE_API_KEY=AIza...

# ── Deployment ─────────────────────────────────────────────────────────────────
VERCEL_TOKEN=...
RAILWAY_TOKEN=...

# ── Apple Developer (iOS) ──────────────────────────────────────────────────────
APPLE_ID=your_apple_id@email.com
