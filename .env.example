# .env.example — Nexus AI Pro environment variables
# Updated: 2026-08-05
# NEVER commit real values to version control.
# Copy this file to .env and fill in your values.

# ============================================================
# CORE SERVER
# ============================================================
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ============================================================
# SECURITY — generate with: openssl rand -hex 64
# ============================================================
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_SECRET=
ENCRYPTION_SALT=

# ============================================================
# AI MODEL PROVIDERS
# ============================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=

# ============================================================
# PAYMENTS — Stripe
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Crypto wallet addresses (display-only — never store private keys)
CRYPTO_WALLET_ETH=
CRYPTO_WALLET_BTC=
CRYPTO_WALLET_USDC=
CRYPTO_WALLET_SOL=
CRYPTO_WALLET_MATIC=
CRYPTO_WALLET_USDT=

# ============================================================
# ANALYTICS — Social Platforms
# ============================================================
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
TWITCH_ACCESS_TOKEN=
TWITCH_CLIENT_ID=
DISCORD_BOT_TOKEN=
REDDIT_ACCESS_TOKEN=
LEMON8_ACCESS_TOKEN=
REDGIFS_ACCESS_TOKEN=

# ============================================================
# GAME / PROJECT CONNECTORS
# ============================================================
EPIC_ACCESS_TOKEN=
SONY_PSN_ACCESS_TOKEN=
MICROSOFT_PARTNER_TOKEN=
UBISOFT_APP_TOKEN=
STEAM_WEB_API_KEY=
GITHUB_TOKEN=
BITBUCKET_ACCESS_TOKEN=

# ============================================================
# CLOUD CONNECTORS
# ============================================================
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

ADOBE_API_KEY=
ADOBE_CLIENT_SECRET=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_TRANSLATE_API_KEY=

DEEPL_API_KEY=

# ============================================================
# COMMUNICATION CONNECTORS
# ============================================================
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ============================================================
# STORAGE
# ============================================================
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://user:password@localhost:5432/nexus

BLOB_PROVIDER=S3
BLOB_BUCKET=
BLOB_ENDPOINT=

# ============================================================
# INFRASTRUCTURE
# ============================================================
VERCEL_TOKEN=
RAILWAY_TOKEN=
APPLE_ID=
APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
GRAFANA_PASSWORD=
