# ============================================================
# Nexus AI Pro – Environment Configuration Template
# Updated: 2026-08-30
# NEVER commit this file with real values. Copy to .env and
# populate locally. See SECURITY.md for rotation policy.
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173

# ── Authentication (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=CHANGE_ME_64_CHAR_HEX_MINIMUM
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES=7d

# WebAuthn (biometrics) RP ID – should match your domain
WEBAUTHN_RP_ID=localhost

# ── Encryption ────────────────────────────────────────────────
ENCRYPTION_SECRET=CHANGE_ME_64_CHAR_HEX
ENCRYPTION_SALT=CHANGE_ME_64_CHAR_HEX_SALT

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexus_ai_pro
# Or: mongodb://user:password@localhost:27017/nexus_ai_pro

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# With auth: redis://:password@localhost:6379

# ── Blob / Object Storage ─────────────────────────────────────
BLOB_STORAGE_PROVIDER=s3   # s3 | azure | gcs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ── AI Model APIs (never commit real keys) ────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# ── Payments ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_PRO=price_CHANGE_ME
STRIPE_PRICE_ENTERPRISE=price_CHANGE_ME

# ── Social Analytics OAuth ────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_BOT_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
LEMON8_API_KEY=
REDGIFS_API_KEY=

# ── Cloud Connectors ──────────────────────────────────────────
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── DevOps Connectors ─────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# ── Communication Connectors ──────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_BOT_TOKEN=

ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ── Creative Connectors ───────────────────────────────────────
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=

# ── Gaming Connectors ─────────────────────────────────────────
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=

SONY_PSN_CLIENT_ID=
SONY_PSN_CLIENT_SECRET=

XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=

UBISOFT_CLIENT_ID=
UBISOFT_CLIENT_SECRET=

STEAM_API_KEY=

# ── TLS (production) ──────────────────────────────────────────
TLS_CERT_PATH=/etc/ssl/certs/nexus.crt
TLS_KEY_PATH=/etc/ssl/private/nexus.key

# ── i18n / Translation ────────────────────────────────────────
TRANSLATE_API_ENDPOINT=https://your-translate-endpoint/v1/translate
TRANSLATE_API_KEY=
DEFAULT_LOCALE=en

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
