# ================================================
# NEXUS AI PRO v2.1 — Environment Configuration
# 2026-06-12 | Copy to .env and fill in your values
# NEVER commit .env to source control
# Generate secrets: openssl rand -hex 32
# ================================================

# ---- Server -------------------------------------------------------
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
FORCE_HTTPS=false

# ---- AI Models ----------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=

# ---- Security (generate: openssl rand -hex 32) --------------------
ENCRYPTION_SECRET=
ENCRYPTION_SALT=
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---- Database -----------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ---- Stripe Payments ----------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ---- Crypto Payments (optional) -----------------------------------
CRYPTO_WALLET_ADDRESS=

# ---- Analytics — Social Media (optional — mock data if absent) ----
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
TWITCH_ACCESS_TOKEN=
DISCORD_BOT_TOKEN=
LEMON8_ACCESS_TOKEN=
REDDIT_ACCESS_TOKEN=
REDGIFS_API_KEY=

# ---- Cloud Connectors (optional) ----------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AZURE_STORAGE_CONNECTION=
GITHUB_TOKEN=
BITBUCKET_TOKEN=
SLACK_WEBHOOK_URL=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=
ADOBE_API_KEY=
ADOBE_ACCESS_TOKEN=

# ---- Game Engine Connectors (optional) ----------------------------
UNREAL_API_KEY=
EPIC_API_KEY=
SONY_PSN_TOKEN=
XBOX_TOKEN=
UBISOFT_TOKEN=

# ---- Translations -------------------------------------------------
GOOGLE_TRANSLATE_API_KEY=

# ---- Email (nodemailer — for MFA codes) ---------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@nexusai.pro

# ---- Deployment ---------------------------------------------------
VERCEL_TOKEN=
RAILWAY_TOKEN=
APPLE_ID=
APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# ---- Monitoring ---------------------------------------------------
GRAFANA_PASSWORD=
