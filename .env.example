# ================================================
# NEXUS AI PRO - Environment Configuration
# Copy this file to .env and fill in your values
# ================================================

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# AI Model API Keys
# Get your keys from the respective providers
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# Security - Generate secure random values
# openssl rand -hex 32
ENCRYPTION_SECRET=generate_a_secure_random_string_here
ENCRYPTION_SALT=generate_another_secure_random_string_here
JWT_SECRET=generate_jwt_secret_here

# Database (for production)
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# Deployment
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# Apple Developer (for iOS deployment)
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# Monitoring
GRAFANA_PASSWORD=secure_grafana_password

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url

# ── Payment Providers (server-side only, never expose to client) ──
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
CRYPTO_CUSTODY_API_KEY=your_custody_provider_key

# ── Social Analytics API Tokens (server-side) ──
TIKTOK_ACCESS_TOKEN=your_tiktok_token
INSTAGRAM_ACCESS_TOKEN=your_instagram_token
FACEBOOK_ACCESS_TOKEN=your_facebook_token
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_secret

# ── Game Platform Developer Tokens ──
EPIC_CLIENT_ID=your_epic_client_id
EPIC_CLIENT_SECRET=your_epic_secret
SONY_DEVELOPER_TOKEN=your_psn_token
MICROSOFT_XBOX_DEVELOPER_KEY=your_xbox_key
UBISOFT_CONNECT_KEY=your_ubisoft_key

# ── External Connectors ──
AZURE_DEVOPS_TOKEN=your_azure_pat
BITBUCKET_APP_PASSWORD=your_bitbucket_app_password
ZOOM_JWT_TOKEN=your_zoom_jwt
ADOBE_CLIENT_ID=your_adobe_client_id
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
GOOGLE_WORKSPACE_KEY=your_google_workspace_key
