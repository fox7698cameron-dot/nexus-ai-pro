# ================================================
# NEXUS AI PRO - Environment Configuration
# File: .env.example | Updated: 2026-08-31
# Copy this file to .env and fill in your values.
# NEVER commit .env - it is git-ignored.
# Generate secrets: openssl rand -hex 64
# ================================================

# ── Server ─────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Security ────────────────────────────────────
# Generate secure random values (min 64 hex chars for secrets)
ENCRYPTION_SECRET=generate_with_openssl_rand_hex_64
ENCRYPTION_SALT=generate_with_openssl_rand_hex_64
JWT_SECRET=generate_with_openssl_rand_hex_64
JWT_EXPIRY_MS=3600000
REFRESH_EXPIRY_MS=604800000
PASSWORD_PEPPER=generate_with_openssl_rand_hex_32

# ── AI Models ──────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key

# ── Database & Cache ────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379
REDIS_TLS=false
BLOB_STORAGE_URL=your_blob_storage_connection_string
BLOB_CONTAINER=nexus-uploads

# ── Stripe Payments ─────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_PRO=price_your_pro_price_id
STRIPE_PRICE_ENTERPRISE=price_your_enterprise_price_id

# ── Crypto Payments ─────────────────────────────
# Wallet addresses for receiving crypto payments
BTC_RECEIVE_ADDRESS=your_bitcoin_receive_address
ETH_RECEIVE_ADDRESS=your_ethereum_receive_address
USDC_RECEIVE_ADDRESS=your_usdc_receive_address
SOL_RECEIVE_ADDRESS=your_solana_receive_address
CRYPTO_PAYMENT_API_KEY=your_nowpayments_or_coinbase_commerce_key

# ── Social Media Analytics ──────────────────────
# OAuth tokens - obtain via each platform's developer portal
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# ── Game Platform Connectors ────────────────────
EPIC_OAUTH_TOKEN=your_epic_games_oauth_token
SONY_OAUTH_TOKEN=your_sony_developer_oauth_token
MICROSOFT_OAUTH_TOKEN=your_microsoft_xbox_oauth_token
UBISOFT_OAUTH_TOKEN=your_ubisoft_connect_oauth_token
STEAM_API_KEY=your_steam_web_api_key

# ── Enterprise Connectors ───────────────────────
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
ADOBE_CLIENT_ID=your_adobe_client_id
ADOBE_CLIENT_SECRET=your_adobe_client_secret
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_APPLICATION_CREDENTIALS=path_to_service_account.json
SLACK_WEBHOOK_URL=your_slack_webhook_url
SLACK_BOT_TOKEN=your_slack_bot_token
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY=your_github_app_private_key
BITBUCKET_CLIENT_ID=your_bitbucket_oauth_client_id
BITBUCKET_CLIENT_SECRET=your_bitbucket_oauth_client_secret

# ── Translation / i18n ──────────────────────────
TRANSLATE_API_URL=https://api.cognitive.microsofttranslator.com
TRANSLATE_API_KEY=your_azure_translator_key
TRANSLATE_API_REGION=eastus

# ── Apple Developer (iOS) ───────────────────────
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# ── Monitoring ──────────────────────────────────
GRAFANA_PASSWORD=secure_grafana_password_min_16_chars

# ── Deployment ──────────────────────────────────
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token
