# ================================================
# NEXUS AI PRO - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# Generate secrets: openssl rand -hex 32
# ================================================

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# AI Model API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# Security — generate with: openssl rand -hex 32
ENCRYPTION_SECRET=
ENCRYPTION_SALT=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# Payments — Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Payments — Crypto wallet addresses (receive addresses only, never private keys)
CRYPTO_WALLET_BTC=
CRYPTO_WALLET_ETH=
CRYPTO_WALLET_USDC=
CRYPTO_WALLET_USDT=
CRYPTO_WALLET_SOL=

# Cloud — AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Cloud — Azure
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Cloud — Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Adobe Creative Cloud
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=

# Communication
SLACK_BOT_TOKEN=xoxb-...
SLACK_WEBHOOK_URL=https://hooks.slack.com/...
ZOOM_API_KEY=
ZOOM_API_SECRET=

# Version Control
GITHUB_TOKEN=ghp_...
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# Game Dev Platforms
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
SONY_CLIENT_ID=
SONY_CLIENT_SECRET=
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
UBISOFT_APP_ID=
UBISOFT_APP_SECRET=
STEAM_API_KEY=

# i18n / Translation
GOOGLE_TRANSLATE_KEY=

# Apple Developer (iOS deployment)
APPLE_ID=
APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# Monitoring
GRAFANA_PASSWORD=

# Deployment
VERCEL_TOKEN=
RAILWAY_TOKEN=
