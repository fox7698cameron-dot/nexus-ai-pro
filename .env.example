# ================================================
# NEXUS AI PRO - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ================================================

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# ── AI Model API Keys ──────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# ── Security — generate with: openssl rand -hex 32 ────────────
ENCRYPTION_SECRET=generate_a_secure_random_string_here
ENCRYPTION_SALT=generate_another_secure_random_string_here
JWT_SECRET=generate_jwt_secret_here_min_32_chars
BLOB_ENCRYPTION_KEY=generate_32_byte_hex_key_for_blob_encryption

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ── Stripe Payments ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── Crypto Payments (Coinbase Commerce) ───────────────────────
COINBASE_COMMERCE_API_KEY=your_coinbase_commerce_api_key

# ── Cloud Storage ──────────────────────────────────────────────
BLOB_STORAGE_PROVIDER=local    # azure | aws | gcs | local

# Azure Blob Storage
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id
AZURE_STORAGE_ACCOUNT=your_storage_account_name
AZURE_STORAGE_KEY=your_storage_account_key

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name

# Google Cloud Storage
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_SERVICE_ACCOUNT_KEY=base64_encoded_service_account_json

# ── Cloud Connectors ───────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_DEFAULT_CHANNEL=#nexus-alerts

ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_REDIRECT_URI=https://nexusai.pro/auth/zoom/callback

GITHUB_TOKEN=ghp_...
GITHUB_ORG=your_github_org

BITBUCKET_WORKSPACE=your_bitbucket_workspace
BITBUCKET_USERNAME=your_bitbucket_username
BITBUCKET_APP_PASSWORD=your_bitbucket_app_password

ADOBE_CLIENT_ID=your_adobe_client_id
ADOBE_CLIENT_SECRET=your_adobe_client_secret
ADOBE_ORG_ID=your_adobe_org_id

# ── Game Dev Platforms ─────────────────────────────────────────
EPIC_CLIENT_ID=your_epic_client_id
EPIC_CLIENT_SECRET=your_epic_client_secret
EPIC_DEPLOYMENT_ID=your_epic_deployment_id

PSN_CLIENT_ID=your_psn_client_id
PSN_CLIENT_SECRET=your_psn_client_secret
PSN_REDIRECT_URI=https://nexusai.pro/auth/psn/callback

XBOX_CLIENT_ID=your_xbox_client_id
XBOX_CLIENT_SECRET=your_xbox_client_secret
XBOX_TENANT_ID=common

UBISOFT_APP_ID=your_ubisoft_app_id
UBISOFT_API_KEY=your_ubisoft_api_key

# ── i18n / Translation ─────────────────────────────────────────
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# ── Deployment ─────────────────────────────────────────────────
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# ── Apple Developer (iOS) ──────────────────────────────────────
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# ── Monitoring ─────────────────────────────────────────────────
GRAFANA_PASSWORD=secure_grafana_password
SLACK_WEBHOOK_URL=your_slack_webhook_url
