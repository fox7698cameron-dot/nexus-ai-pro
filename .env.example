# ================================================
# NEXUS AI PRO - Environment Configuration
# Copy this file to .env and fill in your values
# ================================================

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# AI Model API Keys
# Get your keys from the respective providers
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# Security - Generate secure random values
# openssl rand -hex 32
ENCRYPTION_SECRET=generate_a_secure_random_string_here
ENCRYPTION_SALT=generate_another_secure_random_string_here
JWT_SECRET=generate_jwt_secret_here_minimum_32_chars
JWT_REFRESH_SECRET=generate_separate_refresh_secret_here

# Role invite codes (required to register admin/developer/moderator accounts)
# openssl rand -hex 16
INVITE_CODE_ADMIN=your_admin_invite_code
INVITE_CODE_DEVELOPER=your_developer_invite_code
INVITE_CODE_MODERATOR=your_moderator_invite_code

# Database (for production)
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# Deployment
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# Apple Developer (for iOS deployment)
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# Monitoring
GRAFANA_PASSWORD=secure_grafana_password

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url

# Payment (Stripe — never hardcode keys in source)
STRIPE_SECRET_KEY=sk_live_or_test_your_stripe_secret
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_your_stripe_publishable
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Cloud Connectors (optional)
AZURE_CLIENT_ID=your_azure_client_id
AZURE_TENANT_ID=your_azure_tenant_id
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Dev Connectors (optional)
GITHUB_TOKEN=your_github_token
BITBUCKET_TOKEN=your_bitbucket_token
ZOOM_API_KEY=your_zoom_api_key
ADOBE_API_KEY=your_adobe_api_key

# Translation API (optional)
TRANSLATE_API_KEY=your_deepl_or_google_translate_api_key
