# ================================================
# NEXUS AI PRO — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# Generated: 2026-06-04
# ================================================

# ── Server ───────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── AI Model API Keys ─────────────────────────────
# Generate from provider dashboards — never hard-code
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=

# ── Security (generate with: openssl rand -hex 32) ─
ENCRYPTION_SECRET=
ENCRYPTION_SALT=
JWT_SECRET=

# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ── Payments: Stripe ──────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Payments: Crypto deposit addresses ────────────
# Set your wallet addresses to receive crypto payments
CRYPTO_BTC_ADDRESS=
CRYPTO_ETH_ADDRESS=
CRYPTO_USDC_ADDRESS=
CRYPTO_USDT_ADDRESS=
CRYPTO_SOL_ADDRESS=

# ── Azure ─────────────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_STORAGE_CONNECTION_STRING=

# ── AWS ───────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ── Google Cloud ──────────────────────────────────
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=

# ── Adobe ─────────────────────────────────────────
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=

# ── Slack ─────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# ── Zoom ──────────────────────────────────────────
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ── GitHub / Bitbucket ────────────────────────────
GITHUB_PAT=
BITBUCKET_APP_PASSWORD=

# ── Game Platform APIs ────────────────────────────
EPIC_GAMES_CLIENT_ID=
EPIC_GAMES_CLIENT_SECRET=
PLAYSTATION_ACCESS_TOKEN=
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
UBISOFT_APP_ID=
STEAM_API_KEY=

# ── Apple Developer (iOS) ─────────────────────────
APPLE_ID=
APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# ── Deployment ────────────────────────────────────
VERCEL_TOKEN=
RAILWAY_TOKEN=

# ── Monitoring ────────────────────────────────────
GRAFANA_PASSWORD=
