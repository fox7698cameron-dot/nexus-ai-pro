# ================================================
# NEXUS AI PRO - Environment Configuration
# Updated: 2026-08-04
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# Generate secure secrets: openssl rand -hex 32
# ================================================

# ── Server ───────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# ── Core Security ────────────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=generate_a_64char_hex_secret_here
ENCRYPTION_SALT=generate_another_64char_hex_salt_here
JWT_SECRET=generate_a_jwt_secret_here_min32chars
JWT_REFRESH_SECRET=generate_a_separate_refresh_secret_here
TOKEN_ENCRYPTION_KEY=generate_64char_hex_for_token_encryption

# ── AI Model API Keys ────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ── Blob / Object Storage ────────────────────────
# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Azure Blob
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_CONNECTION_STRING=your_connection_string

# ── Payments ─────────────────────────────────────
# Stripe (supports Visa, Mastercard, Amex, Discover, Diners, JCB, UnionPay)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Crypto wallet receive addresses (no private keys here)
CRYPTO_BTC_ADDRESS=your_btc_receive_address
CRYPTO_ETH_ADDRESS=your_eth_receive_address
CRYPTO_USDC_ADDRESS=your_usdc_receive_address

# ── Social / Analytics Connectors ────────────────
# OAuth tokens are stored encrypted — never raw
# Supply client IDs/secrets used during OAuth flow
TIKTOK_CLIENT_ID=your_tiktok_client_id
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# ── Game Platform Connectors ─────────────────────
# Keys loaded with prefix CONNECTOR_<NAME>
CONNECTOR_UNREALENGINE=your_unreal_api_key
CONNECTOR_EPICGAMES=your_epic_api_key
CONNECTOR_SONYPSN=your_psn_api_key
CONNECTOR_MICROSOFTXBOX=your_xbox_api_key
CONNECTOR_UBISOFTCONNECT=your_ubisoft_api_key
CONNECTOR_STEAMAPI=your_steam_api_key

# ── External Service Connectors ──────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_API_TOKEN=xoxb-your-slack-bot-token
ZOOM_API_KEY=your_zoom_api_key
ZOOM_API_SECRET=your_zoom_api_secret
GITHUB_TOKEN=ghp_your_github_token
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
BITBUCKET_TOKEN=your_bitbucket_app_password
ADOBE_CLIENT_ID=your_adobe_client_id
ADOBE_CLIENT_SECRET=your_adobe_client_secret
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# ── Translation ──────────────────────────────────
# Provider: deepl | google | libre | (blank = disabled)
TRANSLATION_PROVIDER=
DEEPL_API_KEY=your_deepl_api_key
GOOGLE_TRANSLATE_API_KEY=your_google_translate_key
LIBRETRANSLATE_URL=http://localhost:5000

# ── Biometric / WebAuthn ─────────────────────────
WEBAUTHN_RPID=localhost
WEBAUTHN_RPNAME=Nexus AI Pro
WEBAUTHN_ORIGIN=http://localhost:3001

# ── Deployment ───────────────────────────────────
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# ── Apple Developer (iOS) ────────────────────────
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# ── Monitoring ───────────────────────────────────
GRAFANA_PASSWORD=secure_grafana_password
