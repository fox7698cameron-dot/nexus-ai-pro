UBISOFT_CLIENT_ID=
UBISOFT_CLIENT_SECRET=
NINTENDO_CLIENT_ID=

# ── Cloud Services ────────────────────────────────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GOOGLE_CLOUD_PROJECT_ID=
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=

# ── Dev Tools ─────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
