# .env.example
# Created: 2026-10-19
# NexusAI Pro - Environment Variable Template
# NEVER commit the actual .env file to version control
# Copy this file to .env and fill in your values

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3001
HOST=localhost

# ============================================
# SECURITY - REQUIRED
# ============================================
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_BYTE_HEX
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_RANDOM_64_BYTE_HEX
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
ENCRYPTION_SECRET=CHANGE_ME_GENERATE_RANDOM_64_BYTE_HEX
ENCRYPTION_SALT=CHANGE_ME_GENERATE_RANDOM_64_BYTE_HEX

# Session secret - Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
SESSION_SECRET=CHANGE_ME_GENERATE_SESSION_SECRET

# HMAC secret for webhook verification
WEBHOOK_SECRET=CHANGE_ME_GENERATE_WEBHOOK_SECRET

# ============================================
# AI MODEL API KEYS
# ============================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# ============================================
# DATABASE
# ============================================
# Redis (optional - falls back to in-memory if not set)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# PostgreSQL (optional)
DATABASE_URL=postgresql://user:password@localhost:5432/nexusaipro

# MongoDB (optional)
MONGODB_URI=mongodb://localhost:27017/nexusaipro

# Azure Blob Storage (optional)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=nexus-ai-pro

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=nexus-ai-pro

# ============================================
# PAYMENT PROCESSING
# ============================================
# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# Crypto payments (CoinGate, NOWPayments, etc.)
NOWPAYMENTS_API_KEY=
COINGATE_API_KEY=

# Gift card codes (comma-separated, or load from database)
GIFT_CARD_CODES=

# ============================================
# SOCIAL MEDIA INTEGRATIONS
# ============================================
# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram / Meta
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ============================================
# CLOUD SERVICES
# ============================================
# Azure
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Adobe
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=

# ============================================
# PRODUCTIVITY INTEGRATIONS
# ============================================
# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# Zoom
ZOOM_API_KEY=
ZOOM_API_SECRET=
ZOOM_WEBHOOK_SECRET=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Bitbucket
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# ============================================
# GAME DEVELOPMENT CONNECTORS
# ============================================
EPIC_GAMES_CLIENT_ID=
EPIC_GAMES_CLIENT_SECRET=
UNREAL_ENGINE_API_KEY=
UBISOFT_CLIENT_ID=
UBISOFT_CLIENT_SECRET=

# ============================================
# EMAIL / NOTIFICATIONS
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@nexusai.pro

# ============================================
# CORS & ALLOWED ORIGINS
# ============================================
ALLOWED_ORIGINS=http://localhost:5173,https://nexusai.pro

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
AUDIT_LOG_MAX_ENTRIES=1000

# ============================================
# MULTI-LANGUAGE
# ============================================
DEFAULT_LANGUAGE=en
AUTO_TRANSLATE_ENABLED=false
GOOGLE_TRANSLATE_API_KEY=

# ============================================
# BIOMETRICS / WEBAUTHN
# ============================================
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=NexusAI Pro
WEBAUTHN_ORIGIN=http://localhost:5173

# ============================================
# PLATFORM CONFIGURATION
# ============================================
# electron | web | mobile
APP_PLATFORM=web
ELECTRON_DEV=false
IOS_BUNDLE_ID=pro.nexusai.app
ANDROID_PACKAGE=pro.nexusai.app
