# Created: 2025-01-15 | Updated: 2026-05-10
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# Generate random secrets with: openssl rand -hex 64

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com

# ── Security ──────────────────────────────────────────────────
JWT_SECRET=          # 64+ char random string
ENCRYPTION_SECRET=   # 64+ char random string
ENCRYPTION_SALT=     # 64+ char random string
CONNECTOR_ENCRYPTION_KEY=  # 32 bytes as 64-char hex (openssl rand -hex 32)

# ── Database ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── AI APIs (never commit real values) ───────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=

# ── Payments ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Storage ───────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=nexus-uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ── Platform Connectors ───────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# ── Game / Platform Connectors ────────────────────────────────
EPIC_GAMES_CLIENT_ID=
EPIC_GAMES_CLIENT_SECRET=
SONY_CLIENT_ID=
MICROSOFT_CLIENT_ID=
UBISOFT_CLIENT_ID=

# ── i18n / Translation ────────────────────────────────────────
GOOGLE_TRANSLATE_API_KEY=
