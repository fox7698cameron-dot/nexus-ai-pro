# ================================================
# NEXUS AI PRO - Environment Configuration
# Copy this file to .env and fill in your values
# ================================================

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# AI Model API Keys
# Get your keys from the respective providers
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# Security - Generate secure random values
# openssl rand -hex 32
ENCRYPTION_SECRET=generate_a_secure_random_string_here
ENCRYPTION_SALT=generate_another_secure_random_string_here
JWT_SECRET=generate_jwt_secret_here

# Database (for production)
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# Deployment
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# Apple Developer (for iOS deployment)
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# Monitoring
GRAFANA_PASSWORD=secure_grafana_password

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url

# Stripe Payment Processing (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRO_MONTHLY_PRICE_ID=price_your_pro_monthly_id
STRIPE_PRO_ANNUAL_PRICE_ID=price_your_pro_annual_id
STRIPE_ENT_MONTHLY_PRICE_ID=price_your_enterprise_monthly_id
STRIPE_ENT_ANNUAL_PRICE_ID=price_your_enterprise_annual_id

# App URL (for payment redirects)
APP_URL=https://your-app-domain.com

# Social Media Platform API Keys (for analytics)
TIKTOK_API_KEY=your_tiktok_api_key
INSTAGRAM_API_KEY=your_instagram_api_key
FACEBOOK_API_KEY=your_facebook_api_key
TWITCH_API_KEY=your_twitch_api_key
DISCORD_API_KEY=your_discord_api_key
LEMON8_API_KEY=your_lemon8_api_key
REDDIT_API_KEY=your_reddit_api_key
REDGIFS_API_KEY=your_redgifs_api_key

# Game Engine Connectors
UNREAL_API_KEY=your_unreal_engine_api_key
EPIC_CLIENT_ID=your_epic_games_client_id
EPIC_CLIENT_SECRET=your_epic_games_client_secret
PSN_CLIENT_ID=your_playstation_network_client_id
XBOX_CLIENT_ID=your_xbox_live_client_id
UBISOFT_APP_ID=your_ubisoft_connect_app_id

# Crypto Payment Gateway (Coinbase Commerce, BitPay, etc.)
CRYPTO_PAYMENT_GATEWAY_KEY=your_crypto_gateway_api_key

# Cloud Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-nexus-bucket
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
GOOGLE_CLOUD_STORAGE_BUCKET=your_gcs_bucket

# Third-Party Integrations
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
AZURE_CLIENT_ID=your_azure_client_id
AZURE_TENANT_ID=your_azure_tenant_id
ADOBE_CLIENT_ID=your_adobe_client_id
BITBUCKET_CLIENT_ID=your_bitbucket_client_id
