# ================================================
# Nexus AI Pro — Environment Configuration
# Copy to .env and fill in your values
# NEVER commit .env with real secrets
# date: 2026-06-08
# ================================================

# ── Server ────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# ── Security (generate with: openssl rand -hex 32) ─
ENCRYPTION_SECRET=replace_with_openssl_rand_hex_32
ENCRYPTION_SALT=replace_with_openssl_rand_hex_64
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32

# ── AI Model API Keys ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
DEEPSEEK_API_KEY=sk-...
XAI_API_KEY=xai-...
MISTRAL_API_KEY=...

# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ── Blob Storage ──────────────────────────────────
# Options: local | s3 | azure | gcs
BLOB_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads
# AWS S3 (when BLOB_PROVIDER=s3)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=nexus-ai-pro-uploads
# Azure Blob (when BLOB_PROVIDER=azure)
# AZURE_STORAGE_CONNECTION_STRING=...
# Google Cloud Storage (when BLOB_PROVIDER=gcs)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Payments ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Crypto wallets (optional — used for on-chain payments)
# CRYPTO_WALLET_ETH=0x...
# CRYPTO_WALLET_BTC=bc1...
# CRYPTO_WALLET_USDC=0x...
# COINBASE_WEBHOOK_SECRET=...

# ── Integrations ──────────────────────────────────
# Adobe Creative Cloud
# ADOBE_CLIENT_ID=...
# ADOBE_CLIENT_SECRET=...
# Zoom OAuth App
# ZOOM_CLIENT_ID=...
# ZOOM_CLIENT_SECRET=...
# Slack Bot Token
# SLACK_BOT_TOKEN=xoxb-...
# GitHub OAuth
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...

# ── Translation / i18n ────────────────────────────
# Compatible with DeepL API (https://www.deepl.com/pro-api)
# TRANSLATE_API_URL=https://api-free.deepl.com/v2/translate
# TRANSLATE_API_KEY=...

# ── Apple Developer (iOS) ─────────────────────────
# APPLE_ID=dev@example.com
# APP_SPECIFIC_PASSWORD=...
# APPLE_TEAM_ID=...

# ── Monitoring ────────────────────────────────────
GRAFANA_PASSWORD=change_me_in_production

# ── Deployment ────────────────────────────────────
# VERCEL_TOKEN=...
# RAILWAY_TOKEN=...
