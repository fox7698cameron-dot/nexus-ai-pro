# ================================================
# NEXUS AI PRO - Environment Configuration
# File: .env.example | Updated: 2026-10-06
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ================================================

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# AI Model API Keys
# Get your keys from the respective providers
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# Security - Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=generate_a_secure_random_string_here
ENCRYPTION_SALT=generate_another_secure_random_string_here
JWT_SECRET=generate_jwt_secret_here_minimum_32_chars

# Stripe Payment Processing (server-side only - never expose public key here)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Crypto Payment (connect to Coinbase Commerce, etc.)
CRYPTO_PAYMENT_API_KEY=your_crypto_payment_api_key
CRYPTO_PAYMENT_WEBHOOK_SECRET=your_crypto_webhook_secret

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# Azure Integration
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret

# AWS Integration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# Google Cloud Integration
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Adobe Integration
ADOBE_CLIENT_ID=your_adobe_client_id
ADOBE_CLIENT_SECRET=your_adobe_client_secret

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_WEBHOOK_URL=your_slack_webhook_url
SLACK_SIGNING_SECRET=your_slack_signing_secret

# Zoom Integration
ZOOM_API_KEY=your_zoom_api_key
ZOOM_API_SECRET=your_zoom_api_secret

# GitHub Integration
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY_PATH=/path/to/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Bitbucket Integration
BITBUCKET_CLIENT_ID=your_bitbucket_client_id
BITBUCKET_CLIENT_SECRET=your_bitbucket_client_secret

# Game Dev Connectors
EPIC_GAMES_CLIENT_ID=your_epic_games_client_id
EPIC_GAMES_CLIENT_SECRET=your_epic_games_client_secret
SONY_DEVELOPER_API_KEY=your_sony_developer_api_key
MICROSOFT_XBOX_CLIENT_ID=your_xbox_client_id
MICROSOFT_XBOX_CLIENT_SECRET=your_xbox_client_secret
UBISOFT_CONNECT_API_KEY=your_ubisoft_api_key
UNREAL_ENGINE_API_KEY=your_unreal_api_key

# Social Media Analytics
TIKTOK_API_KEY=your_tiktok_api_key
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Deployment
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# Apple Developer (for iOS deployment)
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# Monitoring
GRAFANA_PASSWORD=secure_grafana_password
PROMETHEUS_BEARER_TOKEN=generate_a_secure_token_here

# Storage (Blob)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AWS_S3_BUCKET=your-s3-bucket-name
