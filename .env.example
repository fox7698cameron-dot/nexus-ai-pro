# ================================================
# NEXUS AI PRO - Environment Configuration
# Copy this file to .env and fill in your values
# ================================================

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# AI Model API Keys
# Get your keys from the respective providers
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# Security - Generate secure random values
# openssl rand -hex 32
ENCRYPTION_SECRET=generate_a_secure_random_string_here
ENCRYPTION_SALT=generate_another_secure_random_string_here
JWT_SECRET=generate_jwt_secret_here

# Database (for production)
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# Deployment
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# Apple Developer (for iOS deployment)
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# Monitoring
GRAFANA_PASSWORD=secure_grafana_password

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url

# ================================================
# STRIPE PAYMENTS
# ================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
VITE_STRIPE_PRICE_PRO=price_pro_monthly_id
VITE_STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly_id
APP_URL=http://localhost:3001

# ================================================
# SOCIAL MEDIA PLATFORM CREDENTIALS
# ================================================
# TikTok
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_CONNECTED=false

# Instagram / Facebook (Meta)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
INSTAGRAM_CONNECTED=false
FACEBOOK_CONNECTED=false

# Twitch
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_CONNECTED=false

# Discord
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_CONNECTED=false

# Reddit
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_CONNECTED=false

# Lemon8 / RedGifs
LEMON8_CONNECTED=false
REDGIFS_CONNECTED=false

# ================================================
# TRANSLATION SERVICE
# ================================================
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# ================================================
# GAME PLATFORM CONNECTORS
# ================================================
EPIC_GAMES_CLIENT_ID=your_epic_client_id
EPIC_GAMES_CLIENT_SECRET=your_epic_client_secret
STEAM_API_KEY=your_steam_web_api_key
UNITY_CLOUD_KEY=your_unity_cloud_key

# ================================================
# INTEGRATIONS (Azure, AWS, Google Workspace, etc.)
# ================================================
AZURE_CLIENT_ID=your_azure_client_id
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
GOOGLE_WORKSPACE_CLIENT_ID=your_workspace_client_id
GITHUB_TOKEN=your_github_pat
BITBUCKET_CLIENT_ID=your_bitbucket_client_id
ZOOM_CLIENT_ID=your_zoom_client_id
ADOBE_CLIENT_ID=your_adobe_client_id
