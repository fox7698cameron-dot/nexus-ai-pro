# ================================================
# NEXUS AI PRO v2.1 - Environment Configuration
# 2026-06-06 | Copy this file to .env and fill values
# NEVER commit .env or any actual secrets to version control
# Generate secrets: openssl rand -hex 64
# ================================================

# ─── Server ──────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# ─── AI Model API Keys ────────────────────────────
# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT-4, DALL-E)
OPENAI_API_KEY=

# Google (Gemini + Translate)
GOOGLE_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Other AI providers
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=

# ─── Security (generate strong random values) ─────
# openssl rand -hex 64
ENCRYPTION_SECRET=
ENCRYPTION_SALT=
JWT_SECRET=

# ─── Database ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# Azure Blob Storage (for file uploads)
BLOB_STORAGE_URL=
AZURE_STORAGE_CONNECTION_STRING=

# ─── Payments (Stripe) ────────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENT_MONTHLY=
STRIPE_PRICE_ENT_ANNUAL=

# ─── Cloud Connectors ─────────────────────────────
# Azure
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Communication Connectors ─────────────────────
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ─── Source Control Connectors ────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# Adobe Creative Cloud
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=

# ─── Game Platform Connectors ─────────────────────
# Epic Games / Unreal
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=

# PlayStation Network (Sony)
PSN_API_KEY=

# Xbox / Microsoft
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Ubisoft Connect
UBISOFT_APP_ID=
UBISOFT_APP_SECRET=

# Steam
STEAM_API_KEY=

# ─── Monitoring & Deployment ──────────────────────
GRAFANA_PASSWORD=
PROMETHEUS_PORT=9090

VERCEL_TOKEN=
RAILWAY_TOKEN=

# ─── iOS / macOS (Apple Developer) ───────────────
APPLE_ID=
APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
