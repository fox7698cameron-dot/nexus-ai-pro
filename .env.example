# ================================================
# NEXUS AI PRO - Environment Configuration
# Date: 2026-08-29
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# Generate secrets: openssl rand -hex 32
# ================================================

# ── Server ────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*
APP_URL=http://localhost:5173

# ── AI Model API Keys ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AI...
DEEPSEEK_API_KEY=sk-...
XAI_API_KEY=xai-...
MISTRAL_API_KEY=...
MOONSHOT_API_KEY=...

# ── Security (generate with openssl rand -hex 32) ─
ENCRYPTION_SECRET=generate_a_secure_random_string_here
ENCRYPTION_SALT=generate_another_secure_random_string_here
JWT_SECRET=generate_jwt_secret_here
JWT_REFRESH_SECRET=generate_jwt_refresh_secret_here

# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ── Stripe (https://dashboard.stripe.com/apikeys) ─
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── Crypto Payments (Coinbase Commerce) ───────────
COINBASE_COMMERCE_API_KEY=...

# ── Social Analytics ──────────────────────────────
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_TOKEN=
TWITCH_ACCESS_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_USER_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
LEMON8_ACCESS_TOKEN=
REDDIT_ACCESS_TOKEN=
REDGIFS_ACCESS_TOKEN=

# ── Gaming Platforms ──────────────────────────────
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
PSN_ACCESS_TOKEN=
XBOX_ACCESS_TOKEN=
UBISOFT_TOKEN=

# ── Cloud Connectors ──────────────────────────────
# Azure
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_TRANSLATOR_KEY=
AZURE_DEVOPS_TOKEN=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Collaboration ─────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/...
ZOOM_API_KEY=
ZOOM_API_SECRET=
GITHUB_TOKEN=ghp_...
BITBUCKET_TOKEN=

# ── Deployment ────────────────────────────────────
VERCEL_TOKEN=
RAILWAY_TOKEN=

# ── Apple Developer (iOS) ─────────────────────────
APPLE_ID=your@email.com
APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX

# ── Monitoring ────────────────────────────────────
GRAFANA_PASSWORD=secure_grafana_password
