# ================================================
# NEXUS AI PRO — Environment Configuration
# Copy to .env and fill in values
# NEVER commit .env to version control
# Updated: 2026-05-06
# ================================================

# ── Server ──────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── AI Model API Keys ────────────────────────────
# Obtain from provider dashboards — keep secret
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=

# ── Security (generate: openssl rand -hex 32) ────
ENCRYPTION_SECRET=
ENCRYPTION_SALT=
JWT_SECRET=

# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusaipro
REDIS_URL=redis://localhost:6379

# ── Stripe Payments ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ── Google Cloud (Translate, NLP) ────────────────
VITE_GOOGLE_TRANSLATE_KEY=

# ── AWS S3 / Blob Storage ────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ── Azure Storage ─────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=

# ── Slack ─────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# ── Zoom ──────────────────────────────────────────
ZOOM_API_KEY=
ZOOM_API_SECRET=
ZOOM_JWT_TOKEN=

# ── GitHub ────────────────────────────────────────
GITHUB_TOKEN=

# ── Bitbucket ─────────────────────────────────────
BITBUCKET_TOKEN=

# ── Adobe ─────────────────────────────────────────
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=

# ── Apple Developer (iOS deployment) ────────────
APPLE_ID=
APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# ── Monitoring ────────────────────────────────────
GRAFANA_PASSWORD=
PROMETHEUS_URL=http://localhost:9090

# ── Deployment ────────────────────────────────────
VERCEL_TOKEN=
RAILWAY_TOKEN=
