# ================================================
# NEXUS AI PRO - Environment Configuration
# Updated: 2026-08-07
# Copyright © 2025-2026 Cameron Fox. All rights reserved.
#
# NEVER commit .env to source control.
# Generate secrets with: openssl rand -hex 32
# ================================================

# ── Server ───────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── Security (REQUIRED — generate unique values) ─
# openssl rand -hex 32
ENCRYPTION_SECRET=REPLACE_WITH_openssl_rand_hex_32
ENCRYPTION_SALT=REPLACE_WITH_openssl_rand_hex_32
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# ── AI Model API Keys ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
DEEPSEEK_API_KEY=...
XAI_API_KEY=...
MISTRAL_API_KEY=...

# ── Payments (Stripe) ─────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENT_PRICE_ID=price_...

# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ── Cloud Integrations ────────────────────────────
AZURE_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
GOOGLE_CLOUD_API_KEY=
SLACK_BOT_TOKEN=xoxb-...
SLACK_WEBHOOK_URL=https://hooks.slack.com/...
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
BITBUCKET_ACCESS_TOKEN=
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=

# ── Translation ───────────────────────────────────
TRANSLATION_API_KEY=

# ── Apple Developer (iOS) ─────────────────────────
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id

# ── Monitoring ────────────────────────────────────
GRAFANA_PASSWORD=secure_grafana_password
