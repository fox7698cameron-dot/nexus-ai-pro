# ============================================================
# NEXUS AI PRO — Environment Configuration
# File updated: 2026-08-06
# Copy this file to .env and replace all placeholder values.
# NEVER commit .env to version control.
# Generate secrets: openssl rand -hex 32
# ============================================================

## Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

## AI Model API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
XAI_API_KEY=your_xai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
MOONSHOT_API_KEY=your_moonshot_api_key_here

## Security — generate with: openssl rand -hex 32
ENCRYPTION_SECRET=your_encryption_secret_here
ENCRYPTION_SALT=your_encryption_salt_here
JWT_SECRET=your_jwt_secret_here

## Database
DATABASE_URL=postgresql://user:password@localhost:5432/nexusaipro

## Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here
REDIS_TLS=false

## Stripe (Payment Processing)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

## Crypto Payments
CRYPTO_PAYMENT_WEBHOOK_SECRET=your_crypto_webhook_secret_here

## Microsoft Azure
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_here
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

## Amazon AWS
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name_here

## Google Cloud
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id_here
GOOGLE_CLOUD_KEY_FILE_PATH=/path/to/service-account.json

## Adobe Creative Cloud
ADOBE_CLIENT_ID=your_adobe_client_id_here
ADOBE_CLIENT_SECRET=your_adobe_client_secret_here

## Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here

## Zoom
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here

## GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

## Bitbucket
BITBUCKET_CLIENT_ID=your_bitbucket_client_id_here
BITBUCKET_CLIENT_SECRET=your_bitbucket_client_secret_here

## Translation Service
TRANSLATION_API_KEY=your_translation_api_key_here
TRANSLATION_API_URL=https://api.deepl.com/v2/translate

## Gaming Platform Connectors
EPIC_GAMES_CLIENT_ID=your_epic_client_id_here
EPIC_GAMES_CLIENT_SECRET=your_epic_client_secret_here
PLAYSTATION_APP_ID=your_playstation_app_id_here
XBOX_CLIENT_ID=your_xbox_client_id_here
UBISOFT_APP_ID=your_ubisoft_app_id_here

## Deployment
VERCEL_TOKEN=your_vercel_token_here
RAILWAY_TOKEN=your_railway_token_here

## Apple Developer (iOS)
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password_here
APPLE_TEAM_ID=your_team_id_here

## Monitoring
GRAFANA_PASSWORD=your_grafana_password_here
