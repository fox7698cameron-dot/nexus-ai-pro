# ================================================
# NEXUS AI PRO - Environment Configuration
# Date: 2026-08-16
# Copy this file to .env and fill in your values
# Never commit the actual .env file to version control
# ================================================

# ── Server ─────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# ── AI Model API Keys ───────────────────────────
# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key
# OpenAI (GPT)
OPENAI_API_KEY=your_openai_api_key
# Google (Gemini)
GOOGLE_API_KEY=your_google_api_key
# Others
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# ── Security / JWT ──────────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=generate_a_secure_random_string_here
ENCRYPTION_SALT=generate_another_secure_random_string_here
JWT_SECRET=generate_jwt_secret_min_32_chars_here
JWT_REFRESH_SECRET=generate_refresh_jwt_secret_here

# ── WebAuthn / Biometrics (FIDO2) ───────────────
# Set to your app's domain (e.g. app.example.com) or localhost for dev
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001

# ── Stripe Payments ─────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Get from Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Price IDs from Stripe Dashboard → Products
STRIPE_PRO_MONTHLY_PRICE_ID=price_your_pro_monthly_id
STRIPE_PRO_ANNUAL_PRICE_ID=price_your_pro_annual_id
STRIPE_ENT_MONTHLY_PRICE_ID=price_your_enterprise_monthly_id
STRIPE_ENT_ANNUAL_PRICE_ID=price_your_enterprise_annual_id

# ── Database ────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ── Azure ───────────────────────────────────────
AZURE_CLIENT_ID=your_azure_app_client_id
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_BLOB_ENDPOINT=https://youraccount.blob.core.windows.net

# ── AWS ─────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ── Slack ───────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# ── Zoom ────────────────────────────────────────
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_ACCOUNT_ID=your_zoom_account_id

# ── GitHub ──────────────────────────────────────
GITHUB_TOKEN=ghp_your_github_personal_access_token

# ── Bitbucket ───────────────────────────────────
BITBUCKET_TOKEN=your_bitbucket_access_token
BITBUCKET_WORKSPACE=your_bitbucket_workspace_slug

# ── Adobe ───────────────────────────────────────
ADOBE_CLIENT_ID=your_adobe_client_id
ADOBE_CLIENT_SECRET=your_adobe_client_secret
ADOBE_ORG_ID=your_adobe_org_id

# ── Epic Games / Unreal ─────────────────────────
EPIC_CLIENT_ID=your_epic_games_client_id
EPIC_CLIENT_SECRET=your_epic_games_client_secret
EPIC_DEPLOYMENT_ID=your_epic_deployment_id

# ── Sony PlayStation Network ────────────────────
SONY_PSN_API_KEY=your_psn_api_key
SONY_PSN_CLIENT_ID=your_psn_client_id
SONY_PSN_CLIENT_SECRET=your_psn_client_secret

# ── Microsoft Xbox Live ─────────────────────────
XBOX_CLIENT_ID=your_xbox_app_client_id
XBOX_CLIENT_SECRET=your_xbox_app_client_secret
XBOX_TENANT_ID=your_azure_tenant_for_xbox

# ── Ubisoft Connect ─────────────────────────────
UBISOFT_APP_ID=your_ubisoft_app_id
UBISOFT_CLIENT_ID=your_ubisoft_client_id
UBISOFT_CLIENT_SECRET=your_ubisoft_client_secret
UBISOFT_GENOME_ID=your_ubisoft_genome_id

# ── Deployment ──────────────────────────────────
VERCEL_TOKEN=your_vercel_token
RAILWAY_TOKEN=your_railway_token

# ── Apple / iOS ─────────────────────────────────
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_apple_team_id

# ── Monitoring ──────────────────────────────────
GRAFANA_PASSWORD=secure_grafana_password
