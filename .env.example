# ================================================
# NEXUS AI PRO - Environment Configuration
# Copyright © 2025-2026 Cameron Fox. All rights reserved.
# Created: 2026-05-08
#
# IMPORTANT: Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER hardcode any of these values in source code.
# Generate secrets with: openssl rand -hex 32
# ================================================

# ── Server ────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Security (REQUIRED) ───────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=REPLACE_WITH_SECURE_RANDOM_64_CHAR_HEX
ENCRYPTION_SALT=REPLACE_WITH_SECURE_RANDOM_64_CHAR_HEX
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_64_CHAR_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_SECURE_RANDOM_64_CHAR_HEX

# ── AI Model API Keys ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
DEEPSEEK_API_KEY=sk-...
XAI_API_KEY=xai-...
MISTRAL_API_KEY=...

# ── Storage ───────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_BLOB_CONTAINER=nexus-assets

# ── Stripe Payments ───────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── Social Analytics ──────────────────────────────
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_TOKEN=
TWITCH_ACCESS_TOKEN=
TWITCH_CLIENT_ID=
DISCORD_BOT_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Game Engine Connectors ────────────────────────
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_DEPLOYMENT_ID=
SONY_PSN_ACCESS_TOKEN=
XBOX_ACCESS_TOKEN=
XBOX_CLIENT_ID=
UBISOFT_ACCESS_TOKEN=
UBISOFT_APP_ID=

# ── Cloud Service Connectors ──────────────────────
# Azure DevOps
AZURE_ACCESS_TOKEN=
AZURE_SUBSCRIPTION_ID=
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_ORG=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Google Cloud
GOOGLE_ACCESS_TOKEN=
GOOGLE_TRANSLATE_API_KEY=

# Adobe Creative Cloud
ADOBE_ACCESS_TOKEN=
ADOBE_CLIENT_ID=
ADOBE_ORG_ID=

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Zoom
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# GitHub
GITHUB_TOKEN=ghp_...

# Bitbucket
BITBUCKET_ACCESS_TOKEN=

# ── Deployment ────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
APPLE_ID=your_apple_id@email.com
APP_SPECIFIC_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=your_team_id
