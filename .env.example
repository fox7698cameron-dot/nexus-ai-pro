# ================================================
# NEXUS AI PRO - Environment Configuration
# File: .env.example | Updated: 2026-07-01
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ================================================

# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:3001

# ── AI Model API Keys ─────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=

# ── Security (generate: openssl rand -hex 32) ─
ENCRYPTION_SECRET=
ENCRYPTION_SALT=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379

# ── Stripe ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# ── Crypto Payments (Coinbase Commerce) ───────
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

# ── Email (SMTP) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@nexusai.pro

# ── Azure ─────────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=nexus-blobs

# ── AWS ───────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ── Google Cloud ──────────────────────────────
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_TRANSLATE_API_KEY=

# ── Third-Party ───────────────────────────────
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
ZOOM_API_KEY=
ZOOM_API_SECRET=
GITHUB_TOKEN=
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# ── Social Analytics ──────────────────────────
TIKTOK_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Gaming ────────────────────────────────────
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
PLAYSTATION_CLIENT_ID=
PLAYSTATION_CLIENT_SECRET=
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
UBISOFT_CLIENT_ID=
UBISOFT_CLIENT_SECRET=
STEAM_API_KEY=

# ── Apple / iOS ───────────────────────────────
APPLE_ID=
APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# ── Deployment ────────────────────────────────
VERCEL_TOKEN=
RAILWAY_TOKEN=

# ── Monitoring ────────────────────────────────
GRAFANA_PASSWORD=
SENTRY_DSN=

# ── i18n ──────────────────────────────────────
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,ja,ko,zh,ar,pt,ru,hi,it,nl,sv,pl
