# ================================================
# NEXUS AI PRO — Environment Configuration Template
# Copy to .env and populate values.
# NEVER commit .env to version control.
# NEVER hardcode secrets in source code.
# Generate secrets: openssl rand -hex 32
# Updated: 2026-08-21
# ================================================

# ── Server ──────────────────────────────────────
NODE_ENV=production
PORT=3001
BASE_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com

# ── Security Keys (required) ─────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_SECRET=
ENCRYPTION_SALT=
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── AI Model APIs ────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=

# ── Payments — Stripe ────────────────────────────
# Keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENT_MONTHLY=
STRIPE_PRICE_ENT_ANNUAL=

# ── Payments — Crypto ────────────────────────────
# Optional: CoinPayments / Coinbase Commerce
CRYPTO_PAYMENT_PROVIDER=
CRYPTO_PAYMENT_API_KEY=

# ── Storage & Database ───────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379
BLOB_STORAGE_CONNECTION_STRING=
BLOB_CONTAINER_NAME=nexus-uploads

