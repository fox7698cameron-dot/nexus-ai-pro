{
  "name": "nexus-ai-pro",
  "version": "3.0.0",
  "description": "All-in-one creator/dev platform: 40+ AI models, K-12 education, game/app/web dev (Unreal, Unity, Swift, Python, TS), 3-backend architecture (Node, Python FastAPI, Bun), Kubernetes-ready, multi-platform (web, iOS, Android, Electron desktop)",
  "type": "module",
  "main": "server.js",
  "author": {
    "name": "Cameron Fox",
    "email": "contact@nexusai.pro"
  },
  "license": "Apache-2.0",
  "copyright": "Copyright © 2025-2026 Cameron Fox. All rights reserved.",
  "scripts": {
    "dev":                "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:node":           "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:python":         "concurrently \"uvicorn server:app --reload --port 8000\" \"VITE_API_PORT=8000 vite\"",
    "dev:bun":            "concurrently \"bun --hot server.bun.ts\" \"VITE_API_PORT=3002 vite\"",
    "dev:client":         "vite",
    "dev:server":         "nodemon server.js",
    "dev:server:python":  "uvicorn server:app --reload --host 0.0.0.0 --port 8000",
    "dev:server:bun":     "bun --hot server.bun.ts",
    "start":              "node server.js",
    "start:node":         "node server.js",
    "start:python":       "uvicorn server:app --host 0.0.0.0 --port 8000 --workers 4",
    "start:bun":          "bun run server.bun.ts",
    "build":              "vite build",
    "build:web":          "vite build",
    "build:desktop":      "cd desktop && npm run build:all",
    "build:mobile":       "npm run build && npm run cap:sync",
    "build:all":          "npm run build && npm run build:desktop",
    "preview":            "vite preview",
    "lint":               "eslint . --ext .js,.jsx,.ts,.tsx",
    "test":               "vitest",
    "test:security":      "vitest run --grep security",
    "security:scan":      "node -e \"import('./server.js').then(m => m.security?.scanVulnerabilities())\"",
    "security:patch":     "node -e \"import('./server.js').then(m => m.security?.autoPatch())\"",
    "docker:build:node":  "docker build --target node-runner -t nexus-ai-pro:node-latest .",
    "docker:build:python":"docker build --target python-runner -t nexus-ai-pro:python-latest .",
    "docker:build:bun":   "docker build --target bun-runner -t nexus-ai-pro:bun-latest .",
    "docker:build:all":   "npm run docker:build:node && npm run docker:build:python && npm run docker:build:bun",
    "docker:run":         "docker run -p 3001:3001 --env-file .env nexus-ai-pro:node-latest",
    "docker:compose":     "docker-compose up -d",
    "k8s:apply":          "kubectl apply -k k8s/",
    "k8s:delete":         "kubectl delete -k k8s/",
    "k8s:status":         "kubectl get pods,svc,ingress -n nexus",
    "k8s:logs:node":      "kubectl logs -n nexus -l app=nexus-node -f",
    "k8s:logs:python":    "kubectl logs -n nexus -l app=nexus-python -f",
    "k8s:logs:bun":       "kubectl logs -n nexus -l app=nexus-bun -f",
    "cap:init":           "cap init",
    "cap:add:ios":        "cap add ios",
    "cap:add:android":    "cap add android",
    "cap:sync":           "cap sync",
    "cap:sync:ios":       "cap sync ios",
    "cap:sync:android":   "cap sync android",
    "cap:open:ios":       "cap open ios",
    "cap:open:android":   "cap open android",
    "cap:run:ios":        "cap run ios",
    "cap:run:android":    "cap run android",
    "cap:build:ios":      "npm run build && cap sync ios && cap open ios",
    "cap:build:android":  "npm run build && cap sync android && cap open android",
    "ios:dev":            "cd \"nexus ai pro\" && xcodebuild -workspace \"nexus ai pro.xcworkspace\" -scheme \"nexus ai pro\" -configuration Debug",
    "ios:build":          "cd \"nexus ai pro\" && xcodebuild -workspace \"nexus ai pro.xcworkspace\" -scheme \"nexus ai pro\" -configuration Release archive",
    "android:dev":        "cd android && ./gradlew assembleDebug",
    "android:build":      "cd android && ./gradlew assembleRelease",
    "pwa:build":          "vite build --mode pwa",
    "copyright:add":      "node scripts/add-copyright.js",
    "python:install":     "pip install -r requirements.txt",
    "python:setup":       "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.1",
    "@capacitor/camera": "^6.1.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/keyboard": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/push-notifications": "^6.0.2",
    "@capacitor/share": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "openai": "^4.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.4",
    "winston": "^3.17.0",
    "zod": "^3.24.1",
    "jexl": "^2.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "globals": "^17.0.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.16",
    "workbox-window": "^7.3.0"
  },
  "overrides": {
    "esbuild": "^0.24.2",
    "rollup": "^4.29.1",
    "glob": ">=9.0.0"
  },
  "capacitor": {
    "appId": "com.cameronfox.nexusaipro",
    "appName": "Nexus AI Pro",
    "webDir": "dist",
    "plugins": {
      "SplashScreen": {
        "launchShowDuration": 0
      },
      "BiometricAuth": {
        "allowDeviceCredential": true
      }
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.1.0",
    "python": ">=3.11"
  },
  "keywords": [
    "ai",
    "chatbot",
    "claude",
    "gpt-4",
    "gemini",
    "multi-model",
    "encryption",
    "security",
    "automation",
    "workflow",
    "game-development",
    "app-development",
    "mobile",
    "ios",
    "android",
    "pwa",
    "capacitor"
  ]
}
