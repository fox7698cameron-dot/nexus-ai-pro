{
  "name": "nexus-ai-pro",
  "version": "3.0.0",
  "description": "Enterprise AI platform — multi-model, real-time analytics, security scanning, game dev / AR-VR project tracking",
  "type": "module",
  "main": "server.js",
  "author": {
    "name": "Cameron Fox",
    "email": "contact@nexusai.pro"
  },
  "license": "Apache-2.0",
  "copyright": "Copyright © 2025-2026 Cameron Fox. All rights reserved.",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "nodemon server.js",
    "build": "vite build",
    "build:web": "vite build",
    "build:desktop": "cd desktop && npm run build:all",
    "build:mobile": "npm run build && npm run cap:sync",
    "start": "node server.js",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx",
    "test": "vitest",
    "test:security": "vitest run --grep security",
    "docker:build": "docker build -t nexus-ai-pro .",
    "docker:run": "docker run -p 3001:3001 --env-file .env nexus-ai-pro",
    "docker:compose": "docker-compose up -d",
    "cap:sync": "cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "copyright:add": "node scripts/add-copyright.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/client-ses": "^3.787.0",
    "@azure/identity": "^4.6.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.1",
    "@capacitor/camera": "^6.1.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/keyboard": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/push-notifications": "^6.0.2",
    "@capacitor/share": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "i18next": "^24.2.3",
    "i18next-http-backend": "^3.0.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.11",
    "openai": "^4.77.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.1",
    "recharts": "^2.15.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "stripe": "^17.7.0",
    "uuid": "^11.0.4",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "eslint": "^9.17.0",
    "globals": "^17.0.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.16",
    "workbox-window": "^7.3.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "rollup": "^4.29.1",
    "shell-quote": "^1.8.4",
    "tar": "^7.5.16"
  },
  "capacitor": {
    "appId": "com.cameronfox.nexusaipro",
    "appName": "Nexus AI Pro",
    "webDir": "dist",
    "plugins": {
      "SplashScreen": {
        "launchShowDuration": 0
      },
      "BiometricAuth": {
        "allowDeviceCredential": true
      }
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "analytics",
    "security",
    "game-dev",
    "ar-vr",
    "multi-platform",
    "enterprise",
    "real-time",
    "dashboard"
  ]
}
